worker_processes auto;
worker_rlimit_nofile 200000;

events {
    worker_connections 65535;
    multi_accept on;
}

http {
    include       mime.types;
    default_type  application/octet-stream;

    # Conexões/keepalive
    keepalive_timeout 65;
    keepalive_requests 10000;
    sendfile on; tcp_nopush on; tcp_nodelay on;

    # Uploads (combine com PHP: 2G)
    client_max_body_size 2g;

    upstream moodle_fpm {
        least_conn;
        server 10.100.200.3:9001 max_fails=3 fail_timeout=30s;
        server 10.100.200.3:9002 max_fails=3 fail_timeout=30s;
        server 10.100.200.3:9003 max_fails=3 fail_timeout=30s;
        server 10.100.200.3:9004 max_fails=3 fail_timeout=30s;
        server 10.100.200.3:9005 max_fails=3 fail_timeout=30s;
        server 10.100.200.3:9006 max_fails=3 fail_timeout=30s;
        server 10.100.200.3:9007 max_fails=3 fail_timeout=30s;
        server 10.100.200.3:9008 max_fails=3 fail_timeout=30s;
	keepalive 256;
    }

    server {
        listen 80;
        server_name campusvirtual2.com www.campusvirtual2.com;
    	
	location ^~ /.well-known/acme-challenge/ {
            root /var/www/html;
    	}
	
	location / {
	return 301 https://$host$request_uri;
        }  
    }

    server {
	listen 443 ssl ;
	server_name campusvirtual2.com www.campusvirtual2.com;

	ssl_certificate     /etc/letsencrypt/live/campusvirtual2.com/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/campusvirtual2.com/privkey.pem;

        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;

        root /var/www/html;
        index index.php;

        # Não propague cabeçalhos de proxy aqui — eles vêm do NPM
        # estes podem até ser removidos
	#proxy_set_header Host $host;
	#proxy_set_header X-Real-IP $remote_addr;
        # --- Cabeçalhos para TODAS as requisições ---
	#proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	#proxy_set_header X-Forwarded-Proto https;
	#proxy_set_header X-Forwarded-Port 443;
	#proxy_set_header X-Forwarded-Host $host;
	#	proxy_set_header X-Forwarded-Scheme https;

        location / {
            try_files $uri/ /index.php?$query_string;
	    #proxy_read_timeout 300s;
	    #proxy_connect_timeout 75s;
        }

	#location ~ pluginfile\.php {
	location ~ ^/pluginfile\.php(/.*)?$ {
	    #fastcgi_split_path_info ^(.+\.php)(/.+)$;
    	    include fastcgi_params;
	    fastcgi_param SCRIPT_FILENAME $document_root/pluginfile.php;
	    fastcgi_param PATH_INFO $1;
	    fastcgi_index index.php;
	    fastcgi_pass moodle_fpm;
            gzip off;
      	    gzip_proxied off;
	    proxy_set_header Accept-Encoding "";
	    add_header Content-Encoding "" always;
	    add_header Transfer-Encoding "" always;
            proxy_read_timeout 300s;
            proxy_connect_timeout 75s;

	    fastcgi_buffering on;
	    fastcgi_buffers 64 32k;
	    fastcgi_buffer_size 256k;
	    # Impedir cache corrompido
	    expires off;
            add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0";
            add_header Pragma "no-cache";
	    add_header X-Fastcgi-Path $fastcgi_script_name always;
	    add_header X-Fastcgi-Info $fastcgi_path_info always;
	}	

	location ~ (font\.php|theme\/font\.php) {
	    include fastcgi_params;
	    fastcgi_split_path_info ^(.+\.php)(/.+)$;
	    fastcgi_param SCRIPT_FILENAME /var/www/html$fastcgi_script_name;
	    fastcgi_param PATH_INFO $fastcgi_path_info;
	    fastcgi_pass moodle_fpm;
	}

	location ~ ^/lib/javascript\.php {
   	    fastcgi_split_path_info ^(.+\.php)(/.+)$;
	    include fastcgi_params;
	    fastcgi_param SCRIPT_FILENAME /var/www/html$fastcgi_script_name;
	    fastcgi_param PATH_INFO $fastcgi_path_info;
	    fastcgi_pass moodle_fpm;
	}

	location ~* \.(?:png|svg|jpg|jpeg|gif|webp|ico|css)$ {
 	    try_files $uri @fallback; 
	    add_header Cache-Control "no-store, no-cache, must-revalidate";
	    add_header Pragma "no-cache";
	    expires off;
	    access_log off;
            fastcgi_buffering on;
            fastcgi_buffers 64 32k;
            fastcgi_buffer_size 256k;
            proxy_read_timeout 300s;
            proxy_connect_timeout 75s;

	    #expires 30d;
	}

	location @fallback {
 	    return 404;
	}	
		
	location ~ \.php(/|$) {
	#location ~ [^/]\.php(/|$) {
            fastcgi_index index.php;
	    include fastcgi_params;
	    #try_files $uri =404;
	    fastcgi_split_path_info ^(.+?\.php)(/.*)$;
	    fastcgi_pass moodle_fpm;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
	    fastcgi_param PATH_INFO $fastcgi_path_info;
	    #fastcgi_param PATH_TRANSLATED $document_root$fastcgi_path_info;
	    # FORCE https dentro do PHP
	    fastcgi_param HTTP_X_FORWARDED_SCHEME https;
	    fastcgi_param HTTPS on;
	    fastcgi_param REQUEST_SCHEME https;
	    fastcgi_param X-Forwarded-Proto https;
	    fastcgi_param HTTP_X_FORWARDED_PROTO https;
	    fastcgi_param SERVER_PORT 443;

            fastcgi_keep_conn on;
	    fastcgi_connect_timeout 15s;
	    fastcgi_read_timeout    300s;
	    fastcgi_send_timeout    300s;
	    fastcgi_buffering on;
	    fastcgi_buffers 16 16k;
	    fastcgi_buffer_size 32k;
        }
    }
}

