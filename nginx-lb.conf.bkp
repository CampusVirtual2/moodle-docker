events {
    worker_connections 1024;
}

http {
    upstream moodle_fpm {
        least_conn;
        server campusvirtual.unb.br_fpm01:9000;
        server campusvirtual.unb.br_fpm02:9000;
        server campusvirtual.unb.br_fpm03:9000;
    }

    server {
        listen 80;
	#listen 9000;
        server_name campusvirtual.unb.br www.campusvirtual.unb.br;

        root /var/www/html;
        index index.php;

        # Não propague cabeçalhos de proxy aqui — eles vêm do NPM
        # estes podem até ser removidos
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # --- Cabeçalhos para TODAS as requisições ---
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-Host $host;
	#	proxy_set_header X-Forwarded-Scheme https;

        location / {
            try_files $uri $uri/ /index.php?$query_string;
        }
	location ~ [^/]\.php(/|$) {
            fastcgi_index index.php;
	    include fastcgi_params;
            try_files $fastcgi_script_name =404;
	    fastcgi_split_path_info ^(.+?\.php)(/.*)$;
	    fastcgi_pass moodle_fpm;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
	    fastcgi_param PATH_INFO $fastcgi_path_info;
            fastcgi_param PATH_TRANSLATED $document_root$fastcgi_path_info;
            # FORCE https dentro do PHP
	    fastcgi_param HTTP_X_FORWARDED_SCHEME https;
	    fastcgi_param HTTPS on;
	    fastcgi_param REQUEST_SCHEME https;
	    fastcgi_param X-Forwarded-Proto https;
	    fastcgi_param HTTP_X_FORWARDED_PROTO https;
	    fastcgi_param SERVER_PORT 443;

            fastcgi_keep_conn on;
	    fastcgi_connect_timeout 15s;
	    fastcgi_read_timeout    300s;
	    fastcgi_send_timeout    300s;
	    fastcgi_buffering on;
	    fastcgi_buffers 16 16k;
	    fastcgi_buffer_size 32k;
        }
    }
}

