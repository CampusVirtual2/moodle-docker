<?xml version="1.0"?>
<configuration>

    <!-- Cluster distribuído ativado -->
    <property>
        <name>hbase.cluster.distributed</name>
        <value>true</value>
    </property>

    <!-- Caminho onde o HBase escreve no ZooKeeper -->
    <property>
        <name>zookeeper.znode.parent</name>
        <value>/hbase</value>
    </property>

    <!-- Host ou container que o Web deve usar para acessar o ZooKeeper -->
    <property>
        <name>hbase.zookeeper.quorum</name>
        <value>zookeeper</value>
    </property>

    <!-- Porta padrão -->
    <property>
        <name>hbase.zookeeper.property.clientPort</name>
        <value>2181</value>
    </property>

</configuration>

