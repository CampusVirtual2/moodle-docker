<?xml version="1.0"?>
<configuration>

    <!-- Diretório raiz do HBase -->
    <property>
        <name>hbase.rootdir</name>
        <value>file:///home/pinpoint/hbase</value>
    </property>

    <!-- Cluster distribuído habilitado -->
    <property>
        <name>hbase.cluster.distributed</name>
        <value>true</value>
    </property>

    <!-- Caminho no ZooKeeper onde o HBase armazena seus dados -->
    <property>
        <name>zookeeper.znode.parent</name>
        <value>/hbase</value>
    </property>

    <!-- Nome DNS (ou hostname do container) do ZooKeeper -->
    <property>
        <name>hbase.zookeeper.quorum</name>
        <value>zookeeper</value>
    </property>

    <!-- Porta padrão do ZooKeeper -->
    <property>
        <name>hbase.zookeeper.property.clientPort</name>
        <value>2181</value>
    </property>

    <!-- Porta do master HBase -->
    <property>
        <name>hbase.master.port</name>
        <value>60000</value>
    </property>

    <!-- Porta do regionserver -->
    <property>
        <name>hbase.regionserver.port</name>
        <value>60020</value>
    </property>

</configuration>

