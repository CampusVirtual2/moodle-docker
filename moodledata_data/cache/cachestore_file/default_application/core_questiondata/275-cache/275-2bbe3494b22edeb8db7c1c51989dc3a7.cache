O:8:"stdClass":26:{s:2:"id";s:3:"275";s:8:"category";s:2:"61";s:6:"parent";s:1:"0";s:4:"name";s:20:"Parte I - Questão 4";s:12:"questiontext";s:1498:"<p dir="ltr" style="text-align: left;">Um professor de matemática pediu a seus alunos que criassem um algoritmo em Portugol para calcular a seguinte expressão: o quadrado da soma de dois números (A e B), dividido pela diferença entre eles. A fórmula matemática é: (A+B)2/(A−B). Um aluno escreveu o seguinte código:<br></p>
<div class="console-visualg">
  <div><span class="keyword">algoritmo</span> <span class="string">"CalculoExpressao"</span></div>

  <div><span class="keyword">var</span></div>
  <div><span class="variable">a</span>, <span class="variable">b</span>, <span class="variable">resultado</span>: <span class="keyword">real</span></div>

  <div><br></div>
<div><span class="keyword">inicio</span></div>
  <div style="margin-left: 30px;" class="editor-indent"><div><span class="variable">a</span> &lt;- 10.0</div>
  <div><span class="variable">b</span> &lt;- 5.0</div></div>
  <div><span class="variable">resultado</span> &lt;- <span class="variable">a</span> + <span class="variable">b</span> ^ 2 / <span class="variable">a</span> - <span class="variable">b</span></div>
  <div><span class="function">escreva</span>("O resultado é: ", <span class="variable">resultado</span>)</div>

  <div><br></div>

  <div><span class="keyword">fimalgoritmo<br><br><br></span></div>
</div>

<p dir="ltr" style="text-align: left;">Considerando a ordem de precedência dos operadores aritméticos no VisualG, qual será o valor de resultado exibido pelo algoritmo?</p>";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:488:"<p>A resposta correta é a alternativa <strong>"C"</strong>.<br><br></p>
<div class="destaque-dica">
    <strong><span style="font-size: 1.5em;">📌 Dica:</span><br></strong><br><span style="font-size: 16px">Lembre-se da hierarquia de precedência: primeiro a exponenciação (`^`), depois multiplicação e divisão (`*`, `/`), e por último adição e subtração (`+`, `-`). A avaliação ocorre da esquerda para a direita para operadores do mesmo nível.<br><br>
</span></div><br>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:38:"campusvirtual2.com+250626184645+Eq0sCp";s:11:"timecreated";s:10:"1750963605";s:12:"timemodified";s:10:"1750963605";s:9:"createdby";s:1:"4";s:10:"modifiedby";s:1:"4";s:8:"idnumber";N;s:9:"contextid";s:3:"552";s:6:"status";s:5:"ready";s:9:"versionid";s:3:"243";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:3:"237";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:2:"61";s:4:"name";s:7:"Parte I";s:9:"contextid";s:3:"552";s:4:"info";s:0:"";s:10:"infoformat";s:1:"1";s:5:"stamp";s:52:"addiemooc38.escolavirtual.gov.br+221014194013+Zlu2uj";s:6:"parent";s:2:"60";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:3:"153";s:10:"questionid";s:3:"275";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:27:"Sua resposta está correta.";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:40:"Sua resposta está parcialmente correta.";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:29:"Sua resposta está incorreta.";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:4:"ABCD";s:14:"shownumcorrect";s:1:"1";s:23:"showstandardinstruction";s:1:"0";s:7:"answers";a:5:{i:952;O:8:"stdClass":7:{s:2:"id";s:3:"952";s:8:"question";s:3:"275";s:6:"answer";s:63:"<p dir="ltr" style="text-align: left;">O resultado é: 9.0.</p>";s:12:"answerformat";s:1:"1";s:8:"fraction";s:9:"0.0000000";s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:953;O:8:"stdClass":7:{s:2:"id";s:3:"953";s:8:"question";s:3:"275";s:6:"answer";s:64:"<p dir="ltr" style="text-align: left;">O resultado é: 45.0.</p>";s:12:"answerformat";s:1:"1";s:8:"fraction";s:9:"0.0000000";s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:954;O:8:"stdClass":7:{s:2:"id";s:3:"954";s:8:"question";s:3:"275";s:6:"answer";s:63:"<p dir="ltr" style="text-align: left;">O resultado é: 7.5.</p>";s:12:"answerformat";s:1:"1";s:8:"fraction";s:9:"1.0000000";s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:955;O:8:"stdClass":7:{s:2:"id";s:3:"955";s:8:"question";s:3:"275";s:6:"answer";s:63:"<p dir="ltr" style="text-align: left;">O resultado é: 1.0.</p>";s:12:"answerformat";s:1:"1";s:8:"fraction";s:9:"0.0000000";s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:956;O:8:"stdClass":7:{s:2:"id";s:3:"956";s:8:"question";s:3:"275";s:6:"answer";s:139:"<p dir="ltr" style="text-align: left;">O código gerará um erro, pois a expressão a + b ^ 2 / a - b é ambígua para o interpretador.</p>";s:12:"answerformat";s:1:"1";s:8:"fraction";s:9:"0.0000000";s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}}}s:5:"hints";a:0:{}}