O:8:"stdClass":26:{s:2:"id";s:3:"276";s:8:"category";s:2:"61";s:6:"parent";s:1:"0";s:4:"name";s:20:"Parte I - Questão 5";s:12:"questiontext";s:2413:"<p dir="ltr" style="text-align: left;">Uma loja oferece um desconto de 15% em compras acima de R$ 200,00. Um programador precisa criar um algoritmo que leia o valor total da compra e, se aplicável, calcule e exiba o valor final com o desconto. O código desenvolvido foi:<br></p>
<div class="console-visualg">
    <div><span class="keyword">algoritmo</span> <span class="string">"CalculaDesconto"</span></div>

    <div><span class="keyword">var</span></div>
    <div><span class="variable">valor_compra</span>, <span class="variable">valor_final</span>: <span class="keyword">real</span></div>

    <div><br></div>

    <div><span class="keyword">inicio</span></div>

    <div><span class="function">escreva</span>("Digite o valor da compra: R$ ")</div>
    <div><span class="function">leia</span>(<span class="variable">valor_compra</span>)</div>

    <div><br></div>

    <div><span class="variable">valor_final</span> &lt;- <span class="variable">valor_compra</span></div>

    <div><br></div>

    <div><span class="keyword">se</span> <span class="variable">valor_compra</span> &gt; 200 <span class="keyword">entao</span></div>
    <div>&nbsp;&nbsp;&nbsp;&nbsp;<span class="variable">valor_final</span> &lt;- <span class="variable">valor_compra</span> * 0.85</div>
    <div><span class="keyword">fimse</span></div>

    <div><br></div>

    <div><span class="function">escreval</span>("O valor final a pagar é: R$ ", <span class="variable">valor_final</span>:6:2)</div>

    <div><br></div>

    <div><span class="keyword">fimalgoritmo<br><br><br></span></div>
</div>

<p dir="ltr" style="text-align: left;">Com base no funcionamento das estruturas condicionais (Se-Entao) e operadores relacionais, analise as assertivas:</p>
<ol type="I" style="font-size: 17px;">
    <li>Se um usuário digitar o valor 300, o programa entrará no bloco se, calculará o novo valor_final como 255.00 e o exibirá.</li>
    <li>Se um usuário digitar o valor 200, a condição valor_compra &gt; 200 será FALSO, o bloco se será ignorado e o programa exibirá o valor_final como 200.00.</li>
    <li>O operador relacional &gt; (Maior que) garante que o desconto seja aplicado apenas para valores estritamente maiores que 200, não incluindo o próprio 200.&nbsp;</li>
</ol>
<p dir="ltr" style="text-align: left;">Assinale a alternativa que indica quais assertivas estão corretas.</p>";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:466:"<p>A resposta correta é a alternativa <strong>"E"</strong>.<br><br></p>
<div class="destaque-dica">
    <strong><span style="font-size: 1.5em;">📌 Dica:</span><br></strong><br><span style="font-size: 16px">Analise o fluxo de uma estrutura condicional simples (`Se-Entao`). O bloco de comandos dentro dela só é executado se a condição lógica for VERDADEIRA. Avalie a condição `valor_compra &gt; 200` para cada cenário proposto.<br><br>
</span></div><br>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:38:"campusvirtual2.com+250626185617+9b9Ezm";s:11:"timecreated";s:10:"1750964177";s:12:"timemodified";s:10:"1750964177";s:9:"createdby";s:1:"4";s:10:"modifiedby";s:1:"4";s:8:"idnumber";N;s:9:"contextid";s:3:"552";s:6:"status";s:5:"ready";s:9:"versionid";s:3:"244";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:3:"238";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:2:"61";s:4:"name";s:7:"Parte I";s:9:"contextid";s:3:"552";s:4:"info";s:0:"";s:10:"infoformat";s:1:"1";s:5:"stamp";s:52:"addiemooc38.escolavirtual.gov.br+221014194013+Zlu2uj";s:6:"parent";s:2:"60";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:3:"154";s:10:"questionid";s:3:"276";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:27:"Sua resposta está correta.";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:40:"Sua resposta está parcialmente correta.";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:29:"Sua resposta está incorreta.";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:4:"ABCD";s:14:"shownumcorrect";s:1:"1";s:23:"showstandardinstruction";s:1:"0";s:7:"answers";a:5:{i:957;O:8:"stdClass":7:{s:2:"id";s:3:"957";s:8:"question";s:3:"276";s:6:"answer";s:78:"<p dir="ltr" style="text-align: left;">Apenas a assertiva I está correta.</p>";s:12:"answerformat";s:1:"1";s:8:"fraction";s:9:"0.0000000";s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:958;O:8:"stdClass":7:{s:2:"id";s:3:"958";s:8:"question";s:3:"276";s:6:"answer";s:88:"<p dir="ltr" style="text-align: left;">Apenas as assertivas I e III estão corretas.</p>";s:12:"answerformat";s:1:"1";s:8:"fraction";s:9:"0.0000000";s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:959;O:8:"stdClass":7:{s:2:"id";s:3:"959";s:8:"question";s:3:"276";s:6:"answer";s:79:"<p dir="ltr" style="text-align: left;">Apenas a assertiva II está correta.</p>";s:12:"answerformat";s:1:"1";s:8:"fraction";s:9:"0.0000000";s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:960;O:8:"stdClass":7:{s:2:"id";s:3:"960";s:8:"question";s:3:"276";s:6:"answer";s:80:"<p dir="ltr" style="text-align: left;">Nenhuma das assertivas está correta.</p>";s:12:"answerformat";s:1:"1";s:8:"fraction";s:9:"0.0000000";s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:961;O:8:"stdClass":7:{s:2:"id";s:3:"961";s:8:"question";s:3:"276";s:6:"answer";s:85:"<p dir="ltr" style="text-align: left;">As assertivas I, II e III estão corretas.</p>";s:12:"answerformat";s:1:"1";s:8:"fraction";s:9:"1.0000000";s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}}}s:5:"hints";a:0:{}}