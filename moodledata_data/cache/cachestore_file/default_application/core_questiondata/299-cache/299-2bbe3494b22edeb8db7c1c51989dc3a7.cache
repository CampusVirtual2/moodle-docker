O:8:"stdClass":26:{s:2:"id";s:3:"299";s:8:"category";s:2:"87";s:6:"parent";s:1:"0";s:4:"name";s:21:"Parte II - Questão 8";s:12:"questiontext";s:1676:"<p dir="ltr" style="text-align: left;">Estruturas condicionais aninhadas, combinadas com operadores lógicos, permitem a criação de lógicas de decisão complexas. Dado o código Python abaixo, qual será a saída impressa na tela?<br></p>
<div class="console-visualg">
    <div><span class="variable">idade</span> = <span class="number">25</span></div>
    <div><span class="variable">tem_convite</span> = <span class="keyword">True</span></div>
    <div><span class="variable">nivel_acesso</span> = <span class="number">3</span></div>
    <div><br></div>
    <div><span class="keyword">if</span> <span class="variable">idade</span> &gt;= <span class="number">18</span> <span class="keyword">and</span> <span class="variable">tem_convite</span>:</div>
    <div>    <span class="keyword">if</span> <span class="variable">nivel_acesso</span> &gt; <span class="number">2</span>:</div>
    <div>        <span class="function">print</span>(<span class="string">"Entrada VIP."</span>)</div>
    <div>    <span class="keyword">else</span>:</div>
    <div>        <span class="function">print</span>(<span class="string">"Entrada Padrão."</span>)</div>
    <div><span class="keyword">elif</span> <span class="variable">idade</span> &gt;= <span class="number">18</span> <span class="keyword">and</span> <span class="keyword">not</span> <span class="variable">tem_convite</span>:</div>
    <div>    <span class="function">print</span>(<span class="string">"Verificar Documentação."</span>)</div>
    <div><span class="keyword">else</span>:</div>
    <div>    <span class="function">print</span>(<span class="string">"Acesso Negado."</span>)<br><br><br></div>
</div>";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:419:"<p>A resposta correta é a alternativa <strong>"B"</strong>.<br><br></p>
<div class="destaque-dica">
    <strong><span style="font-size: 1.5em;">📌 Dica:</span><br></strong><br><span style="font-size: 16px">Avalie a condição do `if` principal primeiro. Se ela for verdadeira, avalie a estrutura `if/else` aninhada. O operador `and` requer que ambas as sub-condições sejam verdadeiras.<br><br>
</span></div><br>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:38:"campusvirtual2.com+250626215801+6U5kKc";s:11:"timecreated";s:10:"1750975081";s:12:"timemodified";s:10:"1750975081";s:9:"createdby";s:1:"4";s:10:"modifiedby";s:1:"4";s:8:"idnumber";N;s:9:"contextid";s:3:"552";s:6:"status";s:5:"ready";s:9:"versionid";s:3:"267";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:3:"256";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:2:"87";s:4:"name";s:8:"Parte II";s:9:"contextid";s:3:"552";s:4:"info";s:0:"";s:10:"infoformat";s:1:"1";s:5:"stamp";s:38:"campusvirtual2.com+250626202730+ZoI0BB";s:6:"parent";s:2:"60";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:3:"177";s:10:"questionid";s:3:"299";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:27:"Sua resposta está correta.";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:40:"Sua resposta está parcialmente correta.";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:29:"Sua resposta está incorreta.";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:4:"ABCD";s:14:"shownumcorrect";s:1:"1";s:23:"showstandardinstruction";s:1:"0";s:7:"answers";a:5:{i:1070;O:8:"stdClass":7:{s:2:"id";s:4:"1070";s:8:"question";s:3:"299";s:6:"answer";s:57:"<p dir="ltr" style="text-align: left;">Acesso Negado.</p>";s:12:"answerformat";s:1:"1";s:8:"fraction";s:9:"0.0000000";s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:1071;O:8:"stdClass":7:{s:2:"id";s:4:"1071";s:8:"question";s:3:"299";s:6:"answer";s:55:"<p dir="ltr" style="text-align: left;">Entrada VIP.</p>";s:12:"answerformat";s:1:"1";s:8:"fraction";s:9:"1.0000000";s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:1072;O:8:"stdClass":7:{s:2:"id";s:4:"1072";s:8:"question";s:3:"299";s:6:"answer";s:59:"<p dir="ltr" style="text-align: left;