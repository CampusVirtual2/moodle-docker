O:8:"stdClass":26:{s:2:"id";s:3:"286";s:8:"category";s:2:"88";s:6:"parent";s:1:"0";s:4:"name";s:17:"AFPI - Questão 4";s:12:"questiontext";s:1917:"<p dir="ltr" style="text-align: left;">Um programa deve ler 5 números, somar apenas os números que se enquadrarem em uma determinada regra e, ao final, exibir a soma. O código do programa é exibido a seguir:<br></p>
<div class="console-visualg">
    <div><span class="keyword">algoritmo</span> <span class="string">"Soma"</span></div>
    <div><span class="keyword">var</span></div>
    <div>   <span class="variable">numero</span>, <span class="variable">soma</span>, <span class="variable">i</span>: <span class="keyword">inteiro</span></div>
    <div><span class="keyword">inicio</span></div>
    <div>   <span class="variable">soma</span> &lt;- 0</div>
    <div>   <span class="keyword">para</span> <span class="variable">i</span> <span class="keyword">de</span> 1 <span class="keyword">ate</span> 5 <span class="keyword">faca</span></div>
    <div>      <span class="function">escreva</span>("Digite o ", <span class="variable">i</span>, "º número: ")</div>
    <div>      <span class="function">leia</span>(<span class="variable">numero</span>)</div>
    <div>      <span class="keyword">se</span> <span class="variable">numero</span> &gt; 1 <span class="keyword">entao</span></div>
    <div>         <span class="variable">soma</span> &lt;- <span class="variable">soma</span> + <span class="variable">numero</span></div>
    <div>      <span class="keyword">fimse</span></div>
    <div>   <span class="keyword">fimpara</span></div>
    <div>   <span class="function">escreval</span>("A soma dos números é: ", <span class="variable">soma</span>)</div>
    <div><span class="keyword">fimalgoritmo<br><br><br></span></div>
</div>

<p dir="ltr" style="text-align: left;">Levando em consideração a lógica implementada, se um usuário digitar a seguinte sequência de números: 10, -2, 5, 1, -8, qual será a saída final do programa?</p>
<p dir="ltr" style="text-align: left;"><br></p>";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:72:"<p>A resposta correta é a alternativa <strong>"A"</strong>.<br><br></p>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:38:"campusvirtual2.com+250626210505+7H2nDC";s:11:"timecreated";s:10:"1750971905";s:12:"timemodified";s:10:"1750971905";s:9:"createdby";s:1:"4";s:10:"modifiedby";s:1:"4";s:8:"idnumber";N;s:9:"contextid";s:3:"552";s:6:"status";s:5:"ready";s:9:"versionid";s:3:"254";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:3:"247";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:2:"88";s:4:"name";s:17:"Avaliação Final";s:9:"contextid";s:3:"552";s:4:"info";s:0:"";s:10:"infoformat";s:1:"1";s:5:"stamp";s:38:"campusvirtual2.com+250626202755+tcNTqC";s:6:"parent";s:2:"60";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:3:"164";s:10:"questionid";s:3:"286";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:27:"Sua resposta está correta.";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:40:"Sua resposta está parcialmente correta.";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:29:"Sua resposta está incorreta.";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:4:"ABCD";s:14:"shownumcorrect";s:1:"1";s:23:"showstandardinstruction";s:1:"0";s:7:"answers";a:5:{i:1007;O:8:"stdClass":7:{s:2:"id";s:4:"1007";s:8:"question";s:3:"286";s:6:"answer";s:70:"<p dir="ltr" style="text-align: left;">A soma dos números é: 15.</p>";s:12:"answerformat";s:1:"1";s:8:"fraction";s:9:"1.0000000";s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:1008;O:8:"stdClass":7:{s:2:"id";s:4:"1008";s:8:"question";s:3:"286";s:6:"answer";s:69:"<p dir="ltr" style="text-align: left;">A soma dos números é: 5.</p>";s:12:"answerformat";s:1:"1";s:8:"fraction";s:9:"0.0000000";s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:1009;O:8:"stdClass":7:{s:2:"id";s:4:"1009";s:8:"question";s:3:"286";s:6:"answer";s:70:"<p dir="ltr" style="text-align: left;">A soma dos números é: 16.</p>";s:12:"answerformat";s:1:"1";s:8:"fraction";s:9:"0.0000000";s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:1010;O:8:"stdClass":7:{s:2:"id";s:4:"1010";s:8:"question";s:3:"286";s:6:"answer";s:69:"<p dir="ltr" style="text-align: left;">A soma dos números é: 3.</p>";s:12:"answerformat";s:1:"1";s:8:"fraction";s:9:"0.0000000";s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:1011;O:8:"stdClass":7:{s:2:"id";s:4:"1011";s:8:"question";s:3:"286";s:6:"answer";s:69:"<p dir="ltr" style="text-align: left;">A soma dos números é: 0.</p>";s:12:"answerformat";s:1:"1";s:8:"fraction";s:9:"0.0000000";s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}}}s:5:"hints";a:0:{}}