O:8:"stdClass":26:{s:2:"id";s:3:"316";s:8:"category";s:2:"91";s:6:"parent";s:1:"0";s:4:"name";s:17:"AFPI - Questão 2";s:12:"questiontext";s:2986:"<p dir="ltr" style="text-align: left;">Uma empresa precisa calcular o bônus de final de ano de seus funcionários. Um analista escreveu uma função para determinar o percentual de bônus de acordo com a regra definida no código abaixo.<br></p>
<div class="console-visualg">
    <div><span class="keyword">algoritmo</span> <span class="string">"CalculoBonus"</span></div>
    <div><span class="keyword">var</span></div>
    <div> <span class="variable">salario_base</span>, <span class="variable">bonus_calculado</span>: <span class="keyword">real</span></div>
    <div> <span class="variable">tempo_empresa</span>, <span class="variable">horas_extras</span>: <span class="keyword">inteiro</span></div>
    <div><br></div>
    <div><span class="keyword">funcao</span> <span class="function">obter_percentual_bonus</span>(<span class="variable">anos</span>: <span class="keyword">inteiro</span>; <span class="variable">horas</span>: <span class="keyword">inteiro</span>): <span class="keyword">real</span></div>
    <div><span class="keyword">var</span></div>
    <div> <span class="variable">percentual</span>: <span class="keyword">real</span></div>
    <div><span class="keyword">inicio</span></div>
    <div> <span class="keyword">se</span> (<span class="variable">anos</span> &gt;= 5) <span class="keyword">e</span> (<span class="variable">horas</span> &gt; 100) <span class="keyword">entao</span></div>
    <div> <span class="variable">percentual</span> &lt;- 20.0</div>
    <div> <span class="keyword">senao</span></div>
    <div> <span class="variable">percentual</span> &lt;- 5.0</div>
    <div> <span class="keyword">fimse</span></div>
    <div> <span class="keyword">retorne</span> <span class="variable">percentual</span></div>
    <div><span class="keyword">fimfuncao</span></div>
    <div><br></div>
    <div><span class="keyword">inicio</span> <span>// Bloco principal</span></div>
    <div> <span class="variable">salario_base</span> &lt;- 3000.0</div>
    <div> <span class="variable">tempo_empresa</span> &lt;- 5</div>
    <div> <span class="variable">horas_extras</span> &lt;- 90 <span>// Valor de exemplo</span></div>
    <div><br></div>
    <div> <span class="variable">bonus_calculado</span> &lt;- <span class="variable">salario_base</span> * (<span class="function">obter_percentual_bonus</span>(<span class="variable">tempo_empresa</span>, <span class="variable"><br></span></div><div><span class="variable"><br></span></div><div><span class="variable"><br></span></div><div><span class="variable"> horas_extras</span>) / 100)</div>
    <div><br></div>
    <div> <span class="function">escreval</span>("O valor do bônus é: R$ ", <span class="variable">bonus_calculado</span>:5:2)</div>
    <div><span class="keyword">fimalgoritmo<br><br><br></span></div>
</div>


<p dir="ltr" style="text-align: left;">De acordo com o código apresentado, qual será o valor do bônus exibido na tela para o funcionário do exemplo (tempo_empresa = 5, horas_extras = 90)?</p>";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:72:"<p>A resposta correta é a alternativa <strong>"B"</strong>.<br><br></p>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:38:"campusvirtual2.com+250626205548+uIdt7z";s:11:"timecreated";s:10:"1750971348";s:12:"timemodified";s:10:"1750971348";s:9:"createdby";s:1:"4";s:10:"modifiedby";s:1:"4";s:8:"idnumber";N;s:9:"contextid";s:3:"590";s:6:"status";s:5:"ready";s:9:"versionid";s:3:"284";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:3:"270";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:2:"91";s:4:"name";s:17:"Avaliação Final";s:9:"contextid";s:3:"590";s:4:"info";s:0:"";s:10:"infoformat";s:1:"1";s:5:"stamp";s:38:"campusvirtual2.com+250626202755+tcNTqC";s:6:"parent";s:2:"76";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:3:"194";s:10:"questionid";s:3:"316";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:27:"Sua resposta está correta.";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:40:"Sua resposta está parcialmente correta.";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:29:"Sua resposta está incorreta.";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:4:"ABCD";s:14:"shownumcorrect";s:1:"1";s:23:"showstandardinstruction";s:1:"0";s:7:"answers";a:5:{i:1153;O:8:"stdClass":7:{s:2:"id";s:4:"1153";s:8:"question";s:3:"316";s:6:"answer";s:75:"<p dir="ltr" style="text-align: left;">O valor do bônus é: R$ 600.00.</p>";s:12:"answerformat";s:1:"1";s:8:"fraction";s:9:"0.0000000";s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:1154;O:8:"stdClass":7:{s:2:"id";s:4:"1154";s:8:"question";s:3:"316";s:6:"answer";s:75:"<p dir="ltr" style="text-align: left;">O valor do bônus é: R$ 150.00.</p>";s:12:"answerformat";s:1:"1";s:8:"fraction";s:9:"1.0000000";s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:1155;O:8:"stdClass":7:{s:2:"id";s:4:"1155";s:8:"question";s:3:"316";s:6:"answer";s:127:"<p dir="ltr" style="text-align: left;">O código gerará um erro, pois a função não pode retornar um valor do tipo real.</p>";s:12:"answerformat";s:1:"1";s:8:"fraction";s:9:"0.0000000";s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:1156;O:8:"stdClass":7:{s:2:"id";s:4:"1156";s:8:"question";s:3:"316";s:6:"answer";s:73:"<p dir="ltr" style="text-align: left;">O valor do bônus é: R$ 0.00.</p>";s:12:"answerformat";s:1:"1";s:8:"fraction";s:9:"0.0000000";s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:1157;O:8:"stdClass":7:{s:2:"id";s:4:"1157";s:8:"question";s:3:"316";s:6:"answer";s:76:"<p dir="ltr" style="text-align: left;">O valor do bônus é: R$ 3000.00.</p>";s:12:"answerformat";s:1:"1";s:8:"fraction";s:9:"0.0000000";s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}}}s:5:"hints";a:0:{}}