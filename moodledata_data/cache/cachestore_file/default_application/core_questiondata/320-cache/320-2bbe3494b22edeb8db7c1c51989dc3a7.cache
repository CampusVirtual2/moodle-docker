O:8:"stdClass":26:{s:2:"id";s:3:"320";s:8:"category";s:2:"91";s:6:"parent";s:1:"0";s:4:"name";s:17:"AFPI - Questão 5";s:12:"questiontext";s:2183:"<p dir="ltr" style="text-align: left;">Um professor precisa de um algoritmo que calcule a média de um aluno e exiba sua situação final. Ele implementou a lógica usando estruturas condicionais aninhadas.<br></p>
<div class="console-visualg">
    <div><span class="keyword">algoritmo</span> <span class="string">"StatusAluno"</span></div>
    <div><span class="keyword">var</span></div>
    <div>   <span class="variable">nota1</span>, <span class="variable">nota2</span>, <span class="variable">media</span>: <span class="keyword">real</span></div>
    <div><span class="keyword">inicio</span></div>
    <div>   <span class="function">escreva</span>("Digite a primeira nota: ")</div>
    <div>   <span class="function">leia</span>(<span class="variable">nota1</span>)</div>
    <div>   <span class="function">escreva</span>("Digite a segunda nota: ")</div>
    <div>   <span class="function">leia</span>(<span class="variable">nota2</span>)</div>
    <div><br></div>
    <div>   <span class="variable">media</span> &lt;- (<span class="variable">nota1</span> + <span class="variable">nota2</span>) / 2</div>
    <div>   <span class="function">escreval</span>("Média: ", <span class="variable">media</span>:4:2)</div>
    <div><br></div>
    <div>   <span class="keyword">se</span> <span class="variable">media</span> &gt;= 6 <span class="keyword">entao</span></div>
    <div>      <span class="function">escreval</span>("Situação: Aprovado")</div>
    <div>   <span class="keyword">senao</span></div>
    <div>      <span class="keyword">se</span> <span class="variable">media</span> &gt;= 4 <span class="keyword">entao</span></div>
    <div>         <span class="function">escreval</span>("Situação: Recuperação")</div>
    <div>      <span class="keyword">senao</span></div>
    <div>         <span class="function">escreval</span>("Situação: Reprovado")</div>
    <div>      <span class="keyword">fimse</span></div>
    <div>   <span class="keyword">fimse</span></div>
    <div><span class="keyword">fimalgoritmo</span></div>
</div>
<p dir="ltr" style="text-align: left;">Se um aluno obtiver as notas 6.1 e 6.0, qual será a situação final exibida pelo algoritmo?</p>";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:72:"<p>A resposta correta é a alternativa <strong>"D"</strong>.<br><br></p>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:38:"campusvirtual2.com+250626211035+KhmvYw";s:11:"timecreated";s:10:"1750972235";s:12:"timemodified";s:10:"1750972235";s:9:"createdby";s:1:"4";s:10:"modifiedby";s:1:"4";s:8:"idnumber";N;s:9:"contextid";s:3:"590";s:6:"status";s:5:"ready";s:9:"versionid";s:3:"288";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:3:"273";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:2:"91";s:4:"name";s:17:"Avaliação Final";s:9:"contextid";s:3:"590";s:4:"info";s:0:"";s:10:"infoformat";s:1:"1";s:5:"stamp";s:38:"campusvirtual2.com+250626202755+tcNTqC";s:6:"parent";s:2:"76";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:3:"198";s:10:"questionid";s:3:"320";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:27:"Sua resposta está correta.";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:40:"Sua resposta está parcialmente correta.";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:29:"Sua resposta está incorreta.";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:4:"ABCD";s:14:"shownumcorrect";s:1:"1";s:23:"showstandardinstruction";s:1:"0";s:7:"answers";a:5:{i:1173;O:8:"stdClass":7:{s:2:"id";s:4:"1173";s:8:"question";s:3:"320";s:6:"answer";s:133:"<p dir="ltr" style="text-align: left;">O programa exibirá "Aprovado" e "Recuperação", pois a média satisfaz duas condições.</p>";s:12:"answerformat";s:1:"1";s:8:"fraction";s:9:"0.0000000";s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:1174;O:8:"stdClass":7:{s:2:"id";s:4:"1174";s:8:"question";s:3:"320";s:6:"answer";s:69:"<p dir="ltr" style="text-align: left;">Situação: Recuperação.</p>";s:12:"answerformat";s:1:"1";s:8:"fraction";s:9:"0.0000000";s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:1175;O:8:"stdClass":7:{s:2:"id";s:4:"1175";s:8:"question";s:3:"320";s:6:"answer";s:65:"<p dir="ltr" style="text-align: left;">Situação: Reprovado.</p>";s:12:"answerformat";s:1:"1";s:8:"fraction";s:9:"0.0000000";s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:1176;O:8:"stdClass":7:{s:2:"id";s:4:"1176";s:8:"question";s:3:"320";s:6:"answer";s:64:"<p dir="ltr" style="text-align: left;">Situação: Aprovado.</p>";s:12:"answerformat";s:1:"1";s:8:"fraction";s:9:"1.0000000";s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:1177;O:8:"stdClass":7:{s:2:"id";s:4:"1177";s:8:"question";s:3:"320";s:6:"answer";s:145:"<p dir="ltr" style="text-align: left;">O programa não exibirá situação alguma, pois a lógica das condicionais aninhadas está incorreta.</p>";s:12:"answerformat";s:1:"1";s:8:"fraction";s:9:"0.0000000";s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}}}s:5:"hints";a:0:{}}