ructure and 'Use default section name' has been un-ticked.";s:20:"topcoll:changelayout";s:26:"Change or reset the layout";s:20:"topcoll:changecolour";s:26:"Change or reset the colour";s:29:"topcoll:changetogglealignment";s:36:"Change or reset the toggle alignment";s:27:"topcoll:changetoggleiconset";s:35:"Change or reset the toggle icon set";s:26:"topcoll:changeactivitymeta";s:33:"Change or reset the activity meta";s:12:"instructions";s:60:"Instruções: Clique no nome da seção para mostrar/ocultar";s:19:"displayinstructions";s:20:"Mostrar instruções";s:24:"displayinstructions_help";s:68:"States that the instructions should be displayed to the user or not.";s:26:"defaultdisplayinstructions";s:29:"Display instructions to users";s:31:"defaultdisplayinstructions_desc";s:87:"Display instructions to users informing them how to use the toggles.  Can be yes or no.";s:24:"resetdisplayinstructions";s:20:"Mostrar instruções";s:27:"resetalldisplayinstructions";s:20:"Mostrar instruções";s:29:"resetdisplayinstructions_help";s:65:"Resets the display instructions to follow the site default value.";s:32:"resetalldisplayinstructions_help";s:65:"Resets the display instructions to follow the site default value.";s:17:"feedbackavailable";s:18:"Feedback available";s:12:"xofyanswered";s:46:"{$a->completed} of {$a->participants} answered";s:13:"xofyattempted";s:48:"{$a->completed} de {$a->participants} tentativas";s:15:"xofycontributed";s:49:"{$a->completed} of {$a->participants} contributed";s:10:"xofyposted";s:44:"{$a->completed} of {$a->participants} posted";s:13:"xofysubmitted";s:45:"{$a->completed} de {$a->participants} enviada";s:9:"xanswered";s:24:"{$a->completed} answered";s:10:"xattempted";s:25:"{$a->completed} attempted";s:12:"xcontributed";s:27:"{$a->completed} contributed";s:7:"xposted";s:22:"{$a->completed} posted";s:10:"xsubmitted";s:25:"{$a->completed} submitted";s:9:"xungraded";s:13:"{$a} ungraded";s:15:"creatingsection";s:20:"Creating new section";s:9:"duplicate";s:8:"Duplicar";s:16:"duplicateconfirm";s:112:"Tem certeza que quer duplicar a seção atual? Isso pode demorar um pouco, dependendo da quantidade de recursos.";s:11:"duplicating";s:11:"Duplicating";s:18:"errornosectioninfo";s:40:"The indicated topic have not information";s:15:"progresscounter";s:49:"Duplicating activities ({$a->current}/{$a->size})";s:12:"progressfull";s:17:"Duplicating topic";s:18:"rebuildcoursecache";s:20:"Rebuild course cache";s:12:"readme_title";s:31:"Leia-me do Tópicos Contraídos";s:11:"readme_desc";s:89:"Por favor clique em '{$a->url}' para muito mais informações sobre Tópicos Contraídos.";s:20:"defaultdisplayblocks";s:17:"Blocks to display";s:25:"defaultdisplayblocks_desc";s:315:"Choose the blocks to display in the course when it is first created and this format is selected.  Use the 'Ctrl' key in combination with the mouse to select more than one or none.  Note: This setting will only apply at actual course creation and no other time, i.e. changing to Collapsed Topics from another format.";s:23:"defaultdisplayblocksloc";s:26:"Block location for display";s:28:"defaultdisplayblocksloc_desc";s:77:"Choose the location for the blocks chosen above to display, pre or post side.";s:8:"sidepost";s:4:"Post";s:7:"sidepre";s:3:"Pre";s:11:"information";s:11:"Information";s:19:"informationsettings";s:20:"Information settings";s:23:"informationsettingsdesc";s:35:"Collapsed Topics format information";s:18:"informationchanges";s:7:"Changes";s:8:"settings";s:8:"Settings";s:16:"settingssettings";s:17:"Settings settings";s:20:"settingssettingsdesc";s:32:"Collapsed Topics format settings";s:4:"love";s:4:"love";s:11:"versioninfo";s:108:"Release {$a->release}, version {$a->version} on Moodle {$a->moodle}.  Made with {$a->love} in Great Britain.";s:12:"versionalpha";s:157:"Alpha version - Almost certainly contains bugs.  This is a development version for developers 'only'!  Don't even think of installing on a production server!";s:11:"versionbeta";s:98:"Beta version - Likely to contain bugs.  Ready for testing by administrators on a test server only.";s:9:"versionrc";s:123:"Release candidate version - May contain bugs.  Check completely on a test server before considering on a production server.";s:13:"versionstable";s:105:"Stable version - Could contain bugs.  Check on a test server before installing on your production server.";s:34:"privacy:metadata:preference:toggle";s:37:"The state of the toggles on a course.";s:33:"privacy:request:preference:toggle";s:117:"The course id "{$a->name}" has the value "{$a->value}" which represents "{$a->decoded}" for the state of the toggles.";}