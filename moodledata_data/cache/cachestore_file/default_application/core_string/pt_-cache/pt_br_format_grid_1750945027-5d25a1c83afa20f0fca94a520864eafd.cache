a:104:{s:5:"topic";s:7:"Seção";s:6:"topic0";s:7:"General";s:11:"sectionname";s:7:"Seção";s:10:"pluginname";s:12:"Formato Grid";s:12:"section0name";s:5:"Geral";s:21:"page-course-view-grid";s:55:"Qualquer página principal do curso no formato de grade";s:23:"page-course-view-grid-x";s:45:"Qualquer página do curso no formato de grade";s:10:"addsection";s:17:"Adicionar seção";s:11:"addsections";s:11:"Add section";s:14:"hidefromothers";s:16:"Ocultar seção.";s:14:"showfromothers";s:12:"Show section";s:14:"currentsection";s:13:"Nesta seção";s:17:"markedthissection";s:50:"Esta seção está realçada como a seção atual.";s:15:"markthissection";s:43:"Realçar esta seção como a seção atual.";s:11:"editsection";s:15:"Editar seção.";s:13:"deletesection";s:16:"Excluir seção.";s:15:"editsectionname";s:23:"Editar nome da seção.";s:14:"newsectionname";s:27:"Novo nome para seção {$a}";s:14:"numbersections";s:19:"Número de seções";s:7:"default";s:14:"Padrão - {$a}";s:12:"sectionimage";s:13:"Section image";s:17:"sectionimage_help";s:17:"The section image";s:19:"sectionimagealttext";s:14:"Image alt text";s:24:"sectionimagealttext_help";s:72:"This text will be set as the image 'alt', being 'alternative' attribute.";s:12:"sectionbreak";s:13:"Section break";s:17:"sectionbreak_help";s:30:"Break the grid at this section";s:19:"sectionbreakheading";s:21:"Section break heading";s:24:"sectionbreakheading_help";s:82:"Show this heading at the point this section breaks in the grid.  HTML can be used.";s:17:"gridjustification";s:33:"Set the justification of the grid";s:22:"gridjustification_help";s:96:"Set the justification to one of: Start, Centre, End, Space around, Space between or Space evenly";s:24:"defaultgridjustification";s:33:"Default justification of the grid";s:29:"defaultgridjustification_desc";s:72:"One of: Start, Centre, End, Space around, Space between or Space evenly.";s:5:"start";s:5:"Start";s:6:"centre";s:6:"Centro";s:3:"end";s:3:"End";s:11:"spacearound";s:12:"Space around";s:12:"spacebetween";s:13:"Space between";s:11:"spaceevenly";s:12:"Space evenly";s:19:"imagecontainerwidth";s:29:"Set the image container width";s:24:"imagecontainerwidth_help";s:68:"One of: 128, 192, 210, 256, 320, 384, 448, 512, 576, 640, 704 or 768";s:26:"defaultimagecontainerwidth";s:35:"Largura padrão da caixa de imagem.";s:31:"defaultimagecontainerwidth_desc";s:37:"A largura padrão da caixa de imagem.";s:19:"imagecontainerratio";s:51:"Set the image container ratio relative to the width";s:24:"imagecontainerratio_help";s:43:"One of: 3-2, 3-1, 3-3, 2-3, 1-3, 4-3 or 3-4";s:26:"defaultimagecontainerratio";s:66:"Padrão da proporção da caixa de imagem em relação à largura.";s:31:"defaultimagecontainerratio_desc";s:68:"O padrão da proporção da caixa de imagem em relação à largura.";s:5:"scale";s:6:"Escala";s:4:"crop";s:6:"Cortar";s:17:"imageresizemethod";s:27:"Set the image resize method";s:22:"imageresizemethod_help";s:70:"Set to: 'Scale' or 'Crop' when resizing the image to fit the container";s:24:"defaultimageresizemethod";s:50:"Padrão do método de redimensionamento da imagem.";s:29:"defaultimageresizemethod_desc";s:72:"O padrão do método de redimensionamento da imagem para caber na caixa.";s:8:"original";s:8:"Original";s:4:"webp";s:4:"WebP";s:29:"defaultdisplayedimagefiletype";s:20:"Displayed image type";s:34:"defaultdisplayedimagefiletype_desc";s:21:"'Original' or 'WebP'.";s:3:"off";s:9:"Desligado";s:4:"left";s:8:"Esquerda";s:5:"right";s:7:"Direita";s:22:"singlepagesummaryimage";s:42:"Show the grid image in the section summary";s:27:"singlepagesummaryimage_help";s:38:"When there is a summary in the section";s:29:"defaultsinglepagesummaryimage";s:68:"Mostre a imagem da grade no resumo da seção em uma única página.";s:34:"defaultsinglepagesummaryimage_desc";s:39:"When there is a summary in the section.";s:5:"popup";s:11:"Use a popup";s:10:"popup_help";s:77:"Display the section in a popup instead of navigating to a single section page";s:12:"defaultpopup";s:11:"Use a popup";s:17:"defaultpopup_desc";s:78:"Display the section in a popup instead of navigating to a single section page.";s:21:"sectiontitleingridbox";s:25:"Section title in grid box";s:26:"sectiontitleingridbox_help";s:38:"Show the section title in the grid box";s:28:"defaultsectiontitleingridbox";s:25:"Section title in grid box";s:33:"defaultsectiontitleingridbox_desc";s:39:"Show the section title in the grid box.";s:21:"sectionbadgeingridbox";s:25:"Section badge in grid box";s:26:"sectionbadgeingridbox_help";s:38:"Show the section badge in the grid box";s:28:"defaultsectionbadgeingridbox";s:25:"Section badge in grid box";s:33:"defaultsectionbadgeingridbox_desc";s:39:"Show the section badge in the grid box.";s:14:"showcompletion";s:15:"Show completion";s:19:"showcompletion_help";s:46:"Show the completion of the section on the grid";s:21:"defaultshowcompletion";s:15:"Show completion";s:26:"defaultshowcompletion_desc";s:47:"Show the completion of the section on the grid.";s:11:"information";s:11:"Information";s:19:"informationsettings";s:20:"Information settings";s:23:"informationsettingsdesc";s:23:"Grid format information";s:18:"informationchanges";s:7:"Changes";s:8:"settings";s:8:"Settings";s:16:"settingssettings";s:17:"Settings settings";s:20:"settingssettingsdesc";s:20:"Grid format settings";s:14:"stealthwarning";s:218:"Warning: Course has {$a} orphaned section(s) with content.  Resolve as soon as possible.  Note: Importing into this course from another will turn orphaned sections into real ones - there is no current solution to this!";s:4:"love";s:4:"love";s:11:"versioninfo";s:108:"Release {$a->release}, version {$a->version} on Moodle {$a->moodle}.  Made with {$a->love} in Great Britain.";s:12:"versionalpha";s:157:"Alpha version - Almost certainly contains bugs.  This is a development version for developers 'only'!  Don't even think of installing on a production server!";s:11:"versionbeta";s:98:"Beta version - Likely to contain bugs.  Ready for testing by administrators on a test server only.";s:9:"versionrc";s:123:"Release candidate version - May contain bugs.  Check completely on a test server before considering on a production server.";s:13:"versionstable";s:105:"Stable version - Could contain bugs.  Check on a test server before installing on your production server.";s:42:"cannotconvertuploadedimagetodisplayedimage";s:164:"Não é possível converter a imagem enviada para a imagem exibida. Informe os detalhes do erro e as informações contidas no arquivo php.log para o desenvolvedor.";s:31:"cannotgetmanagesectionimagelock";s:150:"Cannot get manage section image lock.  This can happen if two people are editing the settinsg of the same section on the same course at the same time.";s:18:"formatnotsupported";s:123:"Formato não suportado neste servidor, corrija a configuração do sistema para ter a extensão GD do PHP instalada - {$a}.";s:14:"functionfailed";s:35:"A função falhou na imagem - {$a}.";s:15:"imagemanagement";s:23:"Image management: {$a}.";s:20:"mimetypenotsupported";s:80:"O tipo Mime não é suportado como formato de imagem no formato de grade - {$a}.";s:19:"originalheightempty";s:35:"Altura original está vazia - {$a}.";s:18:"originalwidthempty";s:36:"Largura original está vazia - {$a}.";s:18:"noimageinformation";s:44:"A informação da imagem está vazia - {$a}.";s:11:"reporterror";s:98:"Please use the error information to understand the nature of why the uploaded image cannot be used";s:11:"privacy:nop";s:911:"The Grid format stores lots of settings that pertain to its configuration.  None of the settings are related to a specific user.  It is your responsibilty to ensure that no user data is entered in any of the free text fields.  Setting a setting will result in that action being logged within the core Moodle logging system against the user whom changed it, this is outside of the formats control, please see the core logging system for privacy compliance for this.  When uploading images, you should avoid uploading images with embedded location data (EXIF GPS) included or other such personal data.  It would be possible to extract any location / personal data from the images.  Please examine the code carefully to be sure that it complies with your interpretation of your privacy laws.  I am not a lawyer and my analysis is based on my interpretation.  If you have any doubt then remove the format forthwith.";}