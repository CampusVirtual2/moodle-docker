a:7:{s:12:"alphachannel";s:10:"Canal Alfa";s:17:"alphachannel_help";s:135:"Esse valor determina a transparência da imagem. Você pode definir o canal alfa de 0 (totalmente transparente) a 1 (totalmente opaco).";s:11:"courseimage";s:21:"Imagem do curso: {$a}";s:5:"image";s:6:"Imagem";s:10:"pluginname";s:6:"Imagem";s:16:"privacy:metadata";s:53:"O plugin de Imagem não armazena nenhum dado pessoal.";s:11:"systemimage";s:20:"Imagem do site: {$a}";}