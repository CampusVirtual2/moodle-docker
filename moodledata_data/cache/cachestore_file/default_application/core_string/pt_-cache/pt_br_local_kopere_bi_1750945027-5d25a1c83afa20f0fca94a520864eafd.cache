a:413:{s:17:"active_enrolments";s:17:"Active Enrolments";s:12:"all_learners";s:12:"All learners";s:9:"area_desc";s:23:"Generates an area chart";s:9:"area_name";s:10:"Area Chart";s:9:"block_add";s:13:"Add new Block";s:20:"block_delete_message";s:73:"Do you really want to delete this block and <br> its reports permanently?";s:18:"block_delete_title";s:12:"Delete Block";s:11:"block_extra";s:27:"Very advanced chart options";s:15:"block_not_found";s:15:"Block not found";s:11:"block_theme";s:11:"Block theme";s:16:"block_theme_blue";s:10:"Blue Theme";s:16:"block_theme_dark";s:10:"Dark Theme";s:17:"block_theme_green";s:11:"Green Theme";s:17:"block_theme_light";s:21:"Light Theme (default)";s:18:"block_theme_orange";s:12:"Orange Theme";s:16:"block_theme_pink";s:10:"Pink Theme";s:19:"blocktype_not_found";s:20:"Block type not found";s:18:"c_enablecompletion";s:18:"Completion enabled";s:8:"c_format";s:13:"Course Format";s:10:"c_fullname";s:16:"Full course name";s:4:"c_id";s:9:"Course ID";s:11:"c_shortname";s:10:"Short name";s:7:"c_tempo";s:10:"Time spent";s:14:"c_timemodified";s:11:"Modified on";s:9:"c_visible";s:7:"Visible";s:23:"ca_completed_activities";s:20:"Completed activities";s:10:"cache_time";s:10:"Cache time";s:16:"cache_time_15min";s:10:"15 minutes";s:13:"cache_time_1d";s:8:"24 hours";s:13:"cache_time_1h";s:6:"1 hour";s:16:"cache_time_30min";s:10:"30 minutes";s:13:"cache_time_6h";s:7:"6 hours";s:15:"cache_time_desc";s:67:"Time that the SQL results should remain cached before being cleared";s:13:"cache_time_no";s:8:"No cache";s:29:"cachedef_block_chart_data_15m";s:34:"Cache of chart data for 15 minutes";s:28:"cachedef_block_chart_data_1d";s:29:"Cache of chart data for 1 day";s:28:"cachedef_block_chart_data_1h";s:30:"Cache of chart data for 1 hour";s:29:"cachedef_block_chart_data_30m";s:34:"Cache of chart data for 30 minutes";s:28:"cachedef_block_chart_data_6h";s:30:"Cache of chart data for 6 hour";s:30:"cachedef_block_chart_data_none";s:32:"Cache of chart data with no data";s:25:"cachedef_ip_user_location";s:28:"Cache of user location by IP";s:23:"cachedef_mustache_nosql";s:32:"Cache of Mustache data for NoSQL";s:21:"cachedef_mustache_sql";s:30:"Cache of Mustache data for SQL";s:13:"case_complete";s:8:"Complete";s:15:"case_incomplete";s:10:"Incomplete";s:19:"case_never_accessed";s:14:"Never accessed";s:15:"cat_description";s:20:"Category description";s:8:"cat_edit";s:4:"Edit";s:8:"cat_name";s:13:"Category name";s:7:"cat_new";s:12:"New category";s:13:"cat_not_found";s:18:"Category not found";s:9:"cat_title";s:8:"Category";s:23:"category_delete_confirm";s:17:"Category Deletion";s:23:"category_delete_message";s:89:"Do you really want to delete the category <strong>{$a}</strong> and all pages and blocks?";s:5:"cc_id";s:17:"Completed courses";s:16:"cc_timecompleted";s:12:"Completed on";s:18:"chart_area_default";s:32:"Default Area Chart configuration";s:20:"chart_column_default";s:34:"Default Column Chart configuration";s:18:"chart_default_desc";s:204:"Changing this value will not affect any existing charts<br>Only edit if you are familiar with Apex Charts. See more at <a target="_blank" href="https://apexcharts.com/docs/series/">apexcharts.com/docs</a>";s:18:"chart_line_default";s:32:"Default Line Chart configuration";s:17:"chart_pie_default";s:31:"Default Pie Chart configuration";s:9:"city_name";s:4:"City";s:15:"class_not_found";s:15:"Class not found";s:15:"click_new_block";s:43:"Click on the type of Block you want to add.";s:11:"client_name";s:7:"Browser";s:14:"client_version";s:7:"Version";s:7:"cm_cmid";s:16:"Course Module ID";s:11:"column_desc";s:24:"Generates a Column chart";s:11:"column_name";s:12:"Column Chart";s:18:"completed_learners";s:34:"Learners who completed the courses";s:17:"completion_status";s:8:"Tracking";s:22:"completionstate_status";s:10:"Completion";s:12:"country_name";s:7:"Country";s:16:"course_completed";s:21:"Completion percentage";s:6:"create";s:6:"Create";s:13:"create_report";s:13:"Create report";s:9:"css_extra";s:9:"Extra CSS";s:14:"css_extra_desc";s:153:"Add CSS or SCSS styles to this block.<br> The added CSS will only apply to the content of this Block, and will have no effect on any other part of Moodle";s:14:"ctx_instanceid";s:16:"Enrolled courses";s:14:"data_not_found";s:13:"No data found";s:18:"delete_report_text";s:41:"Do you really want to delete this report?";s:19:"delete_report_title";s:13:"Delete report";s:7:"e_enrol";s:15:"Enrollment type";s:11:"edit_report";s:11:"Edit report";s:12:"enrol_status";s:17:"Enrollment status";s:13:"enrol_timeend";s:21:"Enrollment completion";s:20:"error_chart_renderer";s:25:"Error rendering the chart";s:17:"error_data_loader";s:24:"Error loading chart data";s:18:"expired_enrolments";s:18:"Expired Enrolments";s:25:"extra_langs_customs_title";s:57:"To assist you with new strings, I left some fields blank:";s:28:"extra_langs_filter_component";s:9:"Component";s:29:"extra_langs_header_identifier";s:10:"Identifier";s:27:"extra_langs_header_lang_key";s:15:"Replacement key";s:25:"extra_langs_header_string";s:12:"Current text";s:17:"extra_langs_title";s:24:"Keys that already exist:";s:13:"extra_options";s:22:"Advanced block options";s:9:"firstname";s:12:"Student name";s:12:"g_finalgrade";s:11:"Final grade";s:5:"grade";s:5:"Grade";s:12:"grade_course";s:12:"Course grade";s:10:"html_after";s:87:"Optional additional text (in Text, HTML, or Mustache format) displayed after the chart.";s:11:"html_before";s:86:"Optional additional text (in Text, HTML, or Mustache format) displayed above the chart";s:10:"html_block";s:32:"HTML Block with Mustache support";s:15:"html_block_desc";s:1894:"<p>The HTML added to this field should follow the <strong>Mustache</strong> format, allowing dynamic data substitution in your pages. Use double braces <code>{{ }}</code> to reference SQL column values directly in the HTML, ensuring that the data is correctly inserted.</p>
<blockquote>
    <p>For example, using the following SQL query:</p>
    <pre>SELECT firstname, lastname, email FROM mdl_user WHERE id = :userid</pre>
    <p>You can reference the returned values in your HTML using the following syntax:</p>
    <pre>&lt;p&gt;Email: {{{email}}}&lt;/p&gt;
    &lt;p&gt;Full name: {{{firstname}}} {{{lastname}}}&lt;/p&gt;</pre>
</blockquote>
<blockquote>
    <p>In this example, I want to display multiple rows from an SQL result, which returns a list of users registered with manual authentication. The SQL used for this is:</p>
    <pre>SELECT firstname, lastname, email FROM mdl_user WHERE auth = 'manual'</pre>
    <p>To iterate over the results and display the data in a table format, I use the <code>{{#lines}}</code> in the template to repeat the content for each returned record. The template would look like this:</p>
    <pre>&lt;table class="table table-bordered"&gt;
    &lt;tr&gt;
        &lt;th&gt;E-mail&lt;/th&gt;
        &lt;th&gt;Full name&lt;/th&gt;
    &lt;/tr&gt;
    <strong>{{#lines}}</strong>
        &lt;tr&gt;
            &lt;td&gt;{{{email}}}&lt;/td&gt;
            &lt;td&gt;{{{firstname}}} {{{lastname}}}&lt;/td&gt;
        &lt;/tr&gt;
    <strong>{{/lines}}</strong>
&lt;/table&gt;</pre>
</blockquote>
<p>Triple braces <code>{{{ }}}</code> allow the value to be inserted without escaping HTML, which is useful for displaying content that may contain HTML tags.</p>
<p>For more information on using Mustache templates in Moodle, see the official documentation: <a href="https://moodledev.io/docs/guides/templates" target="_blank">Moodle Templates Guide</a>.</p>";s:9:"html_desc";s:57:"Displays an HTML Block with data coming from the database";s:9:"html_name";s:10:"HTML Block";s:19:"inactive_enrolments";s:19:"Inactive Enrolments";s:9:"info_desc";s:73:"Just information. Ideal for showing student name, enrollment status, etc.";s:14:"info_error_sql";s:19:"Error executing SQL";s:9:"info_name";s:16:"Information Line";s:16:"info_sql_warning";s:74:"Remember that the SQL below must return only one row with just one column.";s:14:"integracaoroot";s:12:"Integrations";s:14:"item_not_found";s:14:"Item not found";s:16:"kopere_bi:manage";s:28:"Manage Business Intelligence";s:14:"kopere_bi:view";s:26:"View Business Intelligence";s:4:"l_ip";s:2:"IP";s:8:"l_origin";s:6:"Origin";s:13:"l_timecreated";s:10:"Created on";s:9:"line_desc";s:22:"Generates a line chart";s:9:"line_name";s:10:"Line Chart";s:16:"line_sql_warning";s:1288:"<p>Remember that the SQL below must return with the following structure:</p>
<ul>
    <li>The first column should contain the text that will be used as the X-axis names.</li>
    <li>The other columns should be structured as follows:
        <ul>
            <li>The column name will be used as the series name. You can use translation strings as explained on the
                <a href="?classname=bi-extra_langs&method=index" target="_blank">strings page</a>.</li>
            <li>The column value will represent the series data in the chart.</li>
        </ul>
    </li>
</ul>
<blockquote>In the example below, the first column returns the course name, and the second column returns the number of news items for each course:
<pre>SELECT fullname,
       newsitems AS "Course news items count"
  FROM mdl_course</pre></blockquote>
<blockquote>In the example below, besides the first column being the course name, it generates two additional lines on the chart, with translated column names:
<pre>  SELECT c.fullname AS course_name,
         COUNT(cm.section) AS 'lang::thiscourse::theme_rebel',
         COUNT(cm.module)  AS 'lang::ca_completed_activities::local_kopere_bi'
    FROM mdl_course AS c
    JOIN mdl_course_modules AS cm ON c.id = cm.course
GROUP BY c.id</pre></blockquote>";s:7:"loading";s:10:"Loading...";s:11:"maps_1_city";s:22:"{a1} and one more city";s:9:"maps_desc";s:51:"Creates a map of online students based on their IPs";s:14:"maps_many_city";s:25:"{a1} and {a2} more cities";s:9:"maps_name";s:19:"Online students map";s:11:"maps_online";s:19:"{a1} student online";s:12:"maps_onlines";s:20:"{a1} students online";s:16:"maps_sql_warning";s:279:"<p>Remember that the SQL below should return only one column, and that column should contain a valid IP.<br>Example: the SQL <code>SELECT lastip FROM {user} WHERE lastaccess > UNIX_TIMESTAMP() - (10 * 60)</code> returns all students who accessed Moodle in the last 10 minutes</p>";s:12:"module_count";s:12:"Module count";s:11:"module_name";s:11:"Module name";s:10:"modulename";s:21:"Business Intelligence";s:9:"new_block";s:22:"New block on this page";s:11:"new_block_1";s:9:"One block";s:12:"new_block_12";s:19:"One plus two blocks";s:11:"new_block_2";s:10:"Two blocks";s:12:"new_block_21";s:18:"Two plus one block";s:12:"new_block_25";s:23:"One wide and one narrow";s:11:"new_block_3";s:12:"Three blocks";s:11:"new_block_4";s:11:"Four blocks";s:12:"new_block_52";s:23:"One narrow and one wide";s:21:"not_accessed_learners";s:44:"Students who haven’t accessed the platform";s:22:"not_completed_learners";s:40:"Students who haven’t completed courses";s:18:"num_activelearners";s:25:"Number of active students";s:21:"num_completedlearners";s:40:"Number of students who completed courses";s:11:"num_courses";s:27:"Number of available courses";s:12:"num_learners";s:24:"Total number of students";s:8:"num_user";s:18:"Number of students";s:7:"os_name";s:16:"Operating system";s:19:"page_delete_confirm";s:13:"Page Deletion";s:19:"page_delete_message";s:75:"Do you really want to delete the page <strong>{$a}</strong> and all blocks?";s:16:"page_description";s:16:"Page description";s:9:"page_edit";s:9:"Edit page";s:9:"page_name";s:9:"Page name";s:12:"page_new_cat";s:8:"New page";s:17:"page_new_sequence";s:38:"Drag blocks to change the block order.";s:14:"page_not_found";s:14:"Page not found";s:12:"page_preview";s:12:"Preview page";s:15:"page_title_edit";s:24:"Edit this page’s title";s:17:"page_title_export";s:11:"Export page";s:8:"pie_desc";s:19:"Creates a pie chart";s:8:"pie_name";s:9:"Pie chart";s:15:"pie_sql_warning";s:147:"<p>The SQL below should return only two columns.</p><p>The first column will be the column name, and the second column must be a numeric value.</p>";s:10:"pluginname";s:21:"Business Intelligence";s:26:"privacy:metadata:city_name";s:50:"The name of the city from which the user accesses.";s:28:"privacy:metadata:client_name";s:51:"The name of the client or browser used by the user.";s:28:"privacy:metadata:client_type";s:51:"The type of client, such as browser or application.";s:31:"privacy:metadata:client_version";s:37:"The version of the client or browser.";s:29:"privacy:metadata:country_code";s:46:"The country code from which the user accesses.";s:29:"privacy:metadata:country_name";s:53:"The name of the country from which the user accesses.";s:20:"privacy:metadata:day";s:18:"The day of access.";s:23:"privacy:metadata:lastip";s:43:"The last registered IP address of the user.";s:25:"privacy:metadata:latitude";s:50:"The latitude of the user's location during access.";s:39:"privacy:metadata:local_kopere_bi_online";s:68:"Table storing information about users currently online for analysis.";s:42:"privacy:metadata:local_kopere_bi_statistic";s:54:"Table storing statistical data for analytics purposes.";s:26:"privacy:metadata:longitude";s:51:"The longitude of the user's location during access.";s:22:"privacy:metadata:month";s:20:"The month of access.";s:24:"privacy:metadata:os_name";s:50:"The name of the operating system used by the user.";s:27:"privacy:metadata:os_version";s:53:"The version of the operating system used by the user.";s:24:"privacy:metadata:seconds";s:31:"The seconds of the access time.";s:24:"privacy:metadata:user_id";s: