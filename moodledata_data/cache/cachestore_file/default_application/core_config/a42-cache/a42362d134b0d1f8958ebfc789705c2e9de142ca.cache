  color: #8b008b; /* roxo */
  font-weight: bold;
}

/* Variáveis em vermelho */
body.course-376 .console-visualg .variable {
  color: #cc0000;
}

/* Strings (entre aspas) em laranja escuro */
body.course-376 .console-visualg .string {
  color: #b5651d;
}

/*calculo*/

body.course-376 .operadores-box {
  background-color: #f9fbfd;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.54);
  border-radius: 8px;
  padding: 20px;
  margin: 30px 0;
  font-size: 1em;
  color: #333;
  line-height: 1.6;
}

body.course-376 .linha-operador {
  margin-bottom: 12px;
}

body.course-376 .linha-operador code {
  background-color: #e6ecf1;
  padding: 2px 5px;
  border-radius: 4px;
  font-family: 'Courier New', monospace;
  font-size: 0.95em;
  color: #005b9f;
}

body.course-376 .linha-operador .operador {
  font-weight: 600;
  color: #1e3a5f;
}

body.course-376 .linha-operador .descricao {
  color: #444;
}

/*caixa-cod-resp*/

body.course-376 .caixa-cod-resp {
  background: #eee;
  font-size: 1em;
  border-radius: 7px;
  padding: 14px;
  box-shadow: 2px 3px 5px #2f2d2d5e;
  border: 1px solid #b4b4b4;
  max-width: 80%;
  overflow-x: auto;
  box-sizing: border-box;
  word-wrap: break-word;

  /* Centralização */
  display: block;
  margin-left: auto;
  margin-right: auto;
  width: fit-content; /* ou defina uma largura fixa ou percentual */
}

/* Responsivo para telas menores */
@media (max-width: 600px) {
  .caixa-destaque {
    font-size: 0.95em;
    padding: 10px;
    width: 100%; /* ocupa toda a largura da tela pequena */
  }
}

/*cod-if*/

body.course-376 .codigo-if {
  background: #1e1e1e;
  padding: 16px;
  border-radius: 6px;
  font-family: 'Courier New', monospace;
  font-size: 1em;
  color: #d4d4d4;
  overflow-x: auto;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.3);
  margin-bottom: 24px;
}

body.course-376 .codigo-if .linha {
  white-space: pre;
  margin-bottom: 2px;
}

body.course-376 .codigo-if .keyword {
  color: #569cd6; /* azul VSCode */
  font-weight: bold;
}

body.course-376 .codigo-if .condicao {
  color: #9cdcfe; /* azul claro */
}

body.course-376 .codigo-if .comment {
  color: #6a9955; /* verde comentário */
  font-style: iinherit;
}

body.course-376 .codigo-if .fim {
  color: #c586c0; /* lilás */
  font-weight: bold;
}

/*Pag-curso-325*/
body.course-376 .referencias-box {
  background-color: #f9fafd;
  padding: 20px 24px;
  margin: 30px 0;
  border-radius: 8px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.44);
  font-family: "Segoe UI", sans-serif;
  color: #2e3a44;
  line-height: 2.0;
}

body.course-376 .titulo-referencias {
  font-size: 2.3em;
  margin-bottom: 16px;
  color: #003350;
  border-bottom: 2px solid #c4d4e3;
  padding-bottom: 4px;
}

body.course-376 .referencia {
  margin-bottom: 14px;
}

body.course-376 .referencia .autor {
  font-weight: 700;
  color: #1d2c3a;
}

body.course-376 .referencia .titulo {
  font-style: normal;
  color: #3d5060;
}

body.course-376 .referencia .fonte {
  color: #5c6b77;
}

/*Quiz/

body.course-376 .atividade-fixacao {
  background: linear-gradient(to bottom right, #f2f6fa, #eaf1f7);
  border-radius: 12px;
  padding: 30px;
  box-shadow: 0 4px 10px rgba(134, 158, 172, 0.25);
  margin: 40px auto;
  max-width: 900px;
  color: #2d3e50;
  font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
}

.atividade-fixacao h2 {
  color: #0a5275;
  font-size: 1.8em;
  margin-bottom: 20px;
  text-align: center;
}


/* POST-IT VERDE CLARO COM PADDING MAIOR */
body.course-376 .post-it-verde {
  background-color: #e6fff0; /* Verde bem claro */
  border-radius: 8px;
  padding: 32px 36px;
  margin: 2rem 0; /* retirado o centralizado */
  width: auto;
  max-width: 900px;
  position: relative;
  box-shadow: 3px 6px 10px rgba(0, 0, 0, 0.1);
  font-family: "Segoe UI", sans-serif;
  font-size: 1.2em;
  color: #1c1c1c;
  line-height: 1.6;
}

/* TACHINHA VERDE MENOR COM MAIS 3D */
body.course-376 .pin-verde::before {
  content: "";
  position: absolute;
  top: -16px;
  left: 28px;
  width: 22px;
  height: 22px;
  background: radial-gradient(circle at 30% 30%, #9de8b4, #1f9254);
  border-radius: 50%;
  box-shadow:
    inset -2px -2px 5px rgba(255, 255, 255, 0.5),
    inset 3px 3px 6px rgba(0, 0, 0, 0.3),
    0 6px 10px rgba(0, 0, 0, 0.4);
  z-index: 2;
}

/* ESTILO BASE */
body.course-376 .post-it-blue,
body.course-376 .post-it-green,
body.course-376 .post-it-red,
body.course-376 .post-it-purple {
  border-radius: 8px;
  padding: 32px 36px;
  margin: 2rem auto;
  width: 90%;
  max-width: 700px;
  position: relative;
  box-shadow: 3px 6px 10px rgba(0, 0, 0, 0.1);
  font-family: "Segoe UI", sans-serif;
  font-size: 1.05em;
  color: #1c1c1c;
  line-height: 1.6;
}

/* CORES DOS POST-ITS */
body.course-376 .post-it-blue {
  background-color: #e6f4ff;
}

body.course-376 .post-it-green {
  background-color: #e5fbe6;
}

body.course-376 .post-it-red {
  background-color: #ffeaea;
}

body.course-376 .post-it-purple {
  background-color: #f3e6ff;
}

/* TACHINHA AZUL */
body.course-376 .pin-azul::before {
  content: "";
  position: absolute;
  top: -16px;
  left: 28px;
  width: 22px;
  height: 22px;
  background: radial-gradient(circle at 30% 30%, #a3d4ff, #065a9f);
  border-radius: 50%;
  box-shadow:
    inset -2px -2px 5px rgba(255, 255, 255, 0.5),
    inset 3px 3px 6px rgba(0, 0, 0, 0.3),
    0 6px 10px rgba(0, 0, 0, 0.4);
  z-index: 2;
}

/* TACHINHA VERDE */
body.course-376 .pin-verde::before {
