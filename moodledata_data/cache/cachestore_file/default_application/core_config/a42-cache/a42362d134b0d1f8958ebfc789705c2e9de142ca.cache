}

body.course-376 .intro-parte {
  background-color: #ffffff;
  padding: 40px;
  border-radius: 16px;
  box-shadow: 0 8px 28px rgba(0, 0, 0, 0.15);
  font-family: 'Segoe UI', sans-serif;
  max-width: 820px;
  margin: 20px auto 80px;
  color: #2b2b2b;
}

body.course-376 .intro-parte h2 {
  font-size: 1.6em;
  color: #d63384;
  margin-bottom: 20px;
  text-align: center;
}

body.course-376 .intro-parte p {
  font-size: 1.1em;
  line-height: 1.8;
  margin-bottom: 16px;
}

/*console-visualg*/

body.course-376 .console-visualg {
  background-color: #ffffff;
  font-family: 'Courier New', monospace;
  font-size: 16px;
  padding: 20px 24px;
  border-radius: 8px;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
  color: #111;
  white-space: pre-wrap;
  line-height: 0.6;
  max-width: 800px;
  margin: 32px auto;
}

/* Comentários em verde */
body.course-376 .console-visualg .comment {
  color: #228B22; /* verde */
}

/* Palavras-chave (algoritmo, var, inicio, se, fimse, etc) em azul escuro */
body.course-376 .console-visualg .keyword {
  color: #0000cc; /* azul escuro */
  font-weight: bold;
}

/* Funções (escreva, escreval, leia) em roxo */
