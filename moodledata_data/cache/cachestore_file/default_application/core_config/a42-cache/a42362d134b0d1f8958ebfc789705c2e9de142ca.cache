  z-index: 2;
}

/* TACHINHA ROXA */
body.course-376 .pin-roxa::before {
  content: "";
  position: absolute;
  top: -16px;
  left: 28px;
  width: 22px;
  height: 22px;
  background: radial-gradient(circle at 30% 30%, #dfccf6, #5b2a82);
  border-radius: 50%;
  box-shadow:
    inset -2px -2px 5px rgba(255, 255, 255, 0.5),
    inset 3px 3px 6px rgba(0, 0, 0, 0.3),
    0 6px 10px rgba(0, 0, 0, 0.4);
  z-index: 2;
}

/*Botão*/

body.course-376 .botao-3d-azul {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 23px 23px !important;
  background: linear-gradient(to bottom, #2980b9, #1c6391);
  color: #fff;
  font-size: 1em;
  font-weight: bold;
  border: none;
  border-radius: 6px;
  box-shadow:
    inset 0 2px 4px rgba(255, 255, 255, 0.3),
    0 4px 6px rgba(0, 0, 0, 0.2);
  text-align: center;
  text-decoration: none;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  height: 36px; /* altura ideal para flex funcionar */
}

body.course-376 .botao-3d-azul:hover {
  transform: translateY(-2px);
  box-shadow:
    inset 0 2px 4px rgba(255, 255, 255, 0.3),
    0 6px 8px rgba(0, 0, 0, 0.3);
}

body.course-376 #page.drawers .activity-header {
  margin-left: 15px;
  margin-right: 15px;
  background: white;
}

body.course-376 p {
  margin-top: 0;
  margin-bottom: 1rem;
  font-size: 17px;
}

body.course-376 .post-it-rx {
  border-radius: 8px;
  padding: 32px 36px;
  margin: 2rem 0;
  width: 100%;
  max-width: 900px;
  position: relative;
  box-shadow: 3px 6px 10px rgba(0, 0, 0, .1);
  font-family: "Segoe UI", sans-serif;
  font-size: 1.2em;
  color: #1c1c1c;
  line-height: 1.6;
  background-color: #f5e6ff; /* Exemplo de cor de fundo lilás claro */
}

body.course-376 .pin-purple::before {
  content: "";
  position: absolute;
  top: -16px;
  left: 12px;
  width: 22px;
  height: 22px;
  background: radial-gradient(circle at 30% 30%, #dfccf6, #5b2a82);
  border-radius: 50%;
  box-shadow:
    inset -2px -2px 5px rgba(255, 255, 255, .5),
    inset 3px 3px 6px rgba(0, 0, 0, .3),
    0 6px 10px rgba(0, 0, 0, .4);
  z-index: 2;
}


/*Tiles*/
.format-tiles #section-0 ul.section {
  border-top: none !important;
  margin: none !important;
 border-top: none !important;
 background-color: none !important;
}
