}

body.course-325 .referencia .titulo {
  font-style: normal;
  color: #3d5060;
}

body.course-325 .referencia .fonte {
  color: #5c6b77;
}

/*Quiz/

body.course-325 .atividade-fixacao {
  background: linear-gradient(to bottom right, #f2f6fa, #eaf1f7);
  border-radius: 12px;
  padding: 30px;
  box-shadow: 0 4px 10px rgba(134, 158, 172, 0.25);
  margin: 40px auto;
  max-width: 900px;
  color: #2d3e50;
  font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
}

.atividade-fixacao h2 {
  color: #0a5275;
  font-size: 1.8em;
  margin-bottom: 20px;
  text-align: center;
}


/* POST-IT VERDE CLARO COM PADDING MAIOR */
body.course-325 .post-it-verde {
  background-color: #e6fff0; /* Verde bem claro */
  border-radius: 8px;
  padding: 32px 36px;
  margin: 2rem 0; /* retirado o centralizado */
  width: auto;
  max-width: 900px;
  position: relative;
  box-shadow: 3px 6px 10px rgba(0, 0, 0, 0.1);
  font-family: "Segoe UI", sans-serif;
  font-size: 1.2em;
  color: #1c1c1c;
  line-height: 1.6;
}

/* TACHINHA VERDE MENOR COM MAIS 3D */
body.course-325 .pin-verde::before {
  content: "";
  position: absolute;
  top: -16px;
  left: 28px;
  width: 22px;
  height: 22px;
  background: radial-gradient(circle at 30% 30%, #9de8b4, #1f9254);
  border-radius: 50%;
  box-shadow:
    inset -2px -2px 5px rgba(255, 255, 255, 0.5),
    inset 3px 3px 6px rgba(0, 0, 0, 0.3),
    0 6px 10px rgba(0, 0, 0, 0.4);
  z-index: 2;
}

/* ESTILO BASE */
body.course-325 .post-it-blue,
body.course-325 .post-it-green,
body.course-325 .post-it-red,
body.course-325 .post-it-purple {
  border-radius: 8px;
  padding: 32px 36px;
  margin: 2rem auto;
  width: 90%;
  max-width: 700px;
  position: relative;
  box-shadow: 3px 6px 10px rgba(0, 0, 0, 0.1);
  font-family: "Segoe UI", sans-serif;
  font-size: 1.05em;
  color: #1c1c1c;
  line-height: 1.6;
}

/* CORES DOS POST-ITS */
body.course-325 .post-it-blue {
  background-color: #e6f4ff;
}

body.course-325 .post-it-green {
  background-color: #e5fbe6;
}

body.course-325 .post-it-red {
  background-color: #ffeaea;
}

body.course-325 .post-it-purple {
  background-color: #f3e6ff;
}

/* TACHINHA AZUL */
body.course-325 .pin-azul::before {
  content: "";
  position: absolute;
  top: -16px;
  left: 28px;
  width: 22px;
  height: 22px;
  background: radial-gradient(circle at 30% 30%, #a3d4ff, #065a9f);
  border-radius: 50%;
  box-shadow:
    inset -2px -2px 5px rgba(255, 255, 255, 0.5),
    inset 3px 3px 6px rgba(0, 0, 0, 0.3),
    0 6px 10px rgba(0, 0, 0, 0.4);
  z-index: 2;
}

/* TACHINHA VERDE */
body.course-325 .pin-verde::before {
