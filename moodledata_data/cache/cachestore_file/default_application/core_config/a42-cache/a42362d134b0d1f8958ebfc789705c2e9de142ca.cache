/* TACHINHA ROXA */
body.course-325 .pin-roxa::before {
  content: "";
  position: absolute;
  top: -16px;
  left: 28px;
  width: 22px;
  height: 22px;
  background: radial-gradient(circle at 30% 30%, #dfccf6, #5b2a82);
  border-radius: 50%;
  box-shadow:
    inset -2px -2px 5px rgba(255, 255, 255, 0.5),
    inset 3px 3px 6px rgba(0, 0, 0, 0.3),
    0 6px 10px rgba(0, 0, 0, 0.4);
  z-index: 2;
}

/*Botão*/

body.course-325 .botao-3d-azul {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 23px 23px !important;
  background: linear-gradient(to bottom, #2980b9, #1c6391);
  color: #fff;
  font-size: 1em;
  font-weight: bold;
  border: none;
  border-radius: 6px;
  box-shadow:
    inset 0 2px 4px rgba(255, 255, 255, 0.3),
    0 4px 6px rgba(0, 0, 0, 0.2);
  text-align: center;
  text-decoration: none;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  height: 36px; /* altura ideal para flex funcionar */
}

body.course-325 .botao-3d-azul:hover {
  transform: translateY(-2px);
  box-shadow:
    inset 0 2px 4px rgba(255, 255, 255, 0.3),
    0 6px 8px rgba(0, 0, 0, 0.3);
}

body.course-325 .post-it-rx {
  border-radius: 8px;
  padding: 32px 36px;
  margin: 2rem 0;
  width: 100%;
  max-width: 900px;
  position: relative;
  box-shadow: 3px 6px 10px rgba(0, 0, 0, .1);
  font-family: "Segoe UI", sans-serif;
  font-size: 1.2em;
  color: #1c1c1c;
  line-height: 1.6;
  background-color: #f5e6ff; /* Exemplo de cor de fundo lilás claro */
}

body.course-325 .pin-purple::before {
  content: "";
  position: absolute;
  top: -16px;
  left: 12px;
  width: 22px;
  height: 22px;
  background: radial-gradient(circle at 30% 30%, #dfccf6, #5b2a82);
  border-radius: 50%;
  box-shadow:
    inset -2px -2px 5px rgba(255, 255, 255, .5),
    inset 3px 3px 6px rgba(0, 0, 0, .3),
    0 6px 10px rgba(0, 0, 0, .4);
  z-index: 2;
}

/*--------------- Página Inicial do Curso 376 ---------------*/
body.course-376 .drawercontent {
  position: relative;
  z-index: -1;
  height: calc(100% - 60px);
  display: flex;
  flex-direction: column;
  flex-wrap: nowrap;
  overflow-y: auto;
  padding: .4rem;
  scrollbar-width: thin;
  scrollbar-color: #425fb8 #f8f9fa;
  background: #e1e4e5;
}
body.course-376 .drawerheader {
  padding: 0;
  height: 60px;
  display: flex;
  align-items: center;
  background: #e1e4e5;
}
body.course-376 .courseindex .courseindex-item:hover .courseindex-link,
body.course-376 .courseindex .courseindex-item:hover .courseindex-chevron,
body.course-376 .courseindex .courseindex-item:focus .courseindex-link,
body.course-376 .courseindex .courseindex-item:focus .courseindex-chevron {
  color: #ff5606;
  cursor: pointer;
}
body.course-376.format-topcoll #region-main {
  background: #ffffff;
 border-left: 8px solid #2b61a2;
 border-radius: 12px;
 box-shadow: 0 2px 8px rgb(0, 0, 0);
}
body.course-376 .course-content ul.topics,
body.course-376 .course-content ul.weeks {
  padding: 0px;
  margin: 0px;
  list-style: none;
  display: block;
}
body.course-376 .course-content ul.ctopics li.section.main,
body.course-376 .course-content ul.ctopics li.tcsection,
body.course-376 .format-topcoll .course-content .single-section .section-navigation {
  position: relative;
  max-width: 100%;
  margin-bottom: 14px;
}
