  position: absolute;
  top: -16px;
  left: 28px;
  width: 22px;
  height: 22px;
  background: radial-gradient(circle at 30% 30%, #b1f4be, #23823f);
  border-radius: 50%;
  box-shadow:
    inset -2px -2px 5px rgba(255, 255, 255, 0.5),
    inset 3px 3px 6px rgba(0, 0, 0, 0.3),
    0 6px 10px rgba(0, 0, 0, 0.4);
  z-index: 2;
}

/* TACHINHA VERMELHA */
body.course-376 .pin-vermelha::before {
  content: "";
  position: absolute;
  top: -16px;
  left: 28px;
  width: 22px;
  height: 22px;
  background: radial-gradient(circle at 30% 30%, #f6b3b3, #b30000);
  border-radius: 50%;
  box-shadow:
    inset -2px -2px 5px rgba(255, 255, 255, 0.5),
    inset 3px 3px 6px rgba(0, 0, 0, 0.3),
