  font-style: italic;
}

body.course-376 .etapas-container {
  background-color: #fffbe6;                  /* fundo bege claro */
  color: #1a1a1a;                             /* texto principal escuro */
  padding: 24px;
  width: 100%;                                /* ocupa toda a largura */
  max-width: 850px;                           /* limite para boa leitura */
  margin: 32px auto 0 auto;                   /* centralizado com espaçamento superior */
  border-radius: 10px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
  font-family: 'Segoe UI', sans-serif;
  display: block;
  position: relative;
  clear: both;
  float: none !important;
  align-self: auto !important;
  flex: none !important;
}

body.course-376 .etapas-container h4 {
