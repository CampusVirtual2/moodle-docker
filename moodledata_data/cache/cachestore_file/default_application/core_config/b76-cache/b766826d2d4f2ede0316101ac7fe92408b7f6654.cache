a:6:{s:7:"version";s:10:"2025030800";s:13:"theme_palette";s:7:"default";s:17:"chart_pie_default";s:895:"{
    chart       : {
        type       : "donut",
        height     : 400,
        width      : "100%",
        zoom       : {
            enabled : false
        },
        dropShadow : {
            enabled : false,
            top     : 3,
            left    : 2,
            blur    : 4,
            opacity : 1
        }
    },
    stroke      : {
        curve  : "smooth",
        width  : 2,
        show   : true,
        colors : ["transparent"]
    },
    dataLabels  : {
        enabled : false
    },
    tooltip     : {
        followCursor : true
    },
    legend      : {
        position : "left",
        offsetY  : 80
    },
    plotOptions : {
        pie    : {
            customScale : 1,
            donut       : {
                size : 0,
            },
            offsetY     : 20,
        },
        stroke : {
            colors : undefined
        }
    }
}
";s:20:"chart_column_default";s:1020:"{
    chart       : {
        type       : "bar",
        height     : 350,
        zoom       : {
            enabled : true
        },
        dropShadow : {
            enabled : false,
            top     : 3,
            left    : 2,
            blur    : 4,
            opacity : 1
        }
    },
    stroke      : {
        curve : "smooth",
        width : 2,
        show  : true
    },
    dataLabels  : {
        enabled : false
    },
