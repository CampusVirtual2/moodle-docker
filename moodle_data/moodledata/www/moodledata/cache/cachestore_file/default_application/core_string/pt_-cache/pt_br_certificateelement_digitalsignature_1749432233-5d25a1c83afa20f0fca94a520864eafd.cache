a:13:{s:16:"digitalsignature";s:18:"Assinatura Digital";s:19:"errormultipleimages";s:65:"Você só pode selecionar uma imagem (carregada ou compartilhada)";s:6:"height";s:6:"Altura";s:11:"height_help";s:166:"Altura do elemento em mm. O valor pode ser calculado automaticamente para imagens carregadas/compartilhadas se definido como 0, caso contrário, deve ser especificado";s:10:"pluginname";s:18:"Assinatura digital";s:16:"privacy:metadata";s:62:"O plugin Assinatura Digital não armazena nenhum dado pessoal.";s:20:"signaturecontactinfo";s:38:"Informações de contato da assinatura";s:17:"signaturelocation";s:19:"Local de assinatura";s:13:"signaturename";s:18:"Nome da assinatura";s:17:"signaturepassword";s:19:"Senha de assinatura";s:15:"signaturereason";s:20:"Motivo da assinatura";s:5:"width";s:7:"Largura";s:10:"width_help";s:167:"Largura do elemento em mm. O valor pode ser calculado automaticamente para imagens carregadas/compartilhadas se definido como 0, caso contrário, deve ser especificado";}