a:48:{s:10:"pluginname";s:12:"Cards format";s:15:"pluginname_help";s:56:"Course format which displays sections as bootstrap cards";s:11:"addsections";s:8:"Add card";s:14:"currentsection";s:9:"This card";s:11:"editsection";s:9:"Edit card";s:15:"editsectionname";s:14:"Edit card name";s:13:"deletesection";s:11:"Delete card";s:14:"newsectionname";s:22:"New name for card {$a}";s:11:"sectionname";s:4:"Card";s:12:"section0name";s:7:"General";s:23:"page-course-view-topics";s:37:"Any course main page in topics format";s:25:"page-course-view-topics-x";s:32:"Any course page in topics format";s:14:"hidefromothers";s:9:"Hide card";s:14:"showfromothers";s:9:"Show card";s:12:"noactivities";s:13:"No activities";s:15:"section:default";s:9:"Card {$a}";s:29:"section:completion:percentage";s:17:"{$a->percentage}%";s:24:"section:completion:count";s:27:"{$a->completed}/{$a->total}";s:13:"settings:name";s:21:"Cards format settings";s:17:"settings:defaults";s:8:"Defaults";s:29:"settings:defaults:description";s:60:"Set the default value for new courses using the cards format";s:22:"form:course:usedefault";s:14:"Default ({$a})";s:20:"form:course:section0";s:15:"General section";s:25:"form:course:section0_help";s:274:"The general section is the first section in your course, which usually contains the course's announcements page. You can choose to have this visible either only on the course's main page, on top of the card deck, or visible on the main page and each individual section page.";s:31:"form:course:section0:coursepage";s:33:"Only show on the main course page";s:29:"form:course:section0:allpages";s:48:"Show on all pages, including individual sections";s:27:"form:course:cardorientation";s:16:"Card orientation";s:36:"form:course:cardorientation:vertical";s:8:"Vertical";s:38:"form:course:cardorientation:horizontal";s:10:"Horizontal";s:34:"form:course:cardorientation:square";s:6:"Square";s:28:"form:course:importgridimages";s:30:"Import images from grid format";s:33:"form:course:importgridimages_help";s:79:"Copy across the images used for grid tiles and use them as images for each card";s:23:"form:course:showsummary";s:15:"Section summary";s:28:"form:course:showsummary:show";s:5:"Shown";s:28:"form:course:showsummary:hide";s:6:"Hidden";s:28:"form:course:showsummary_help";s:44:"Whether to show the section summary on cards";s:24:"form:course:showprogress";s:16:"Section progress";s:36:"form:course:showprogress:description";s:59:"Whether to display progress within each section on the card";s:29:"form:course:showprogress:show";s:5:"Shown";s:29:"form:course:showprogress:hide";s:6:"Hidden";s:26:"form:course:progressformat";s:19:"Display progress as";s:32:"form:course:progressformat:count";s:16:"A count of items";s:37:"form:course:progressformat:percentage";s:12:"A percentage";s:5:"image";s:5:"Image";s:8:"editcard";s:9:"Edit card";s:22:"editimage:resizefailed";s:129:"Failed to resize the selected image. The card will use the image at it's original size. You can try re-uploading the image later.";s:18:"editimage:imported";s:56:"Successfully imported {$a} image(s) from the grid format";s:16:"privacy:metadata";s:56:"The Card format plugin does not store any personal data.";}