a:4:{s:12:"fieldoptions";s:5:"Campo";s:17:"fieldoptions_help";s:129:"O campo a ser exibido. Se você precisar exibir mais de um campo, adicione mais instâncias desse elemento e configure de acordo.";s:10:"pluginname";s:17:"Campos dinâmicos";s:16:"privacy:metadata";s:64:"O plugin de campos dinâmicos não armazena nenhum dado pessoal.";}