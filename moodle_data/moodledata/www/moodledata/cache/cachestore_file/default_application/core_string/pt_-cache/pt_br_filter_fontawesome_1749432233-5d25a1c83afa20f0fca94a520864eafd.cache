a:5:{s:10:"pluginname";s:17:"FontAwesome icons";s:10:"filtername";s:30:"Filtro de Ícones FontAwesome.";s:14:"settingformats";s:20:"Aplicar aos formatos";s:19:"settingformats_desc";s:97:"O filtro será aplicado somente se o texto original foi inserido em um dos formatos selecionados.";s:16:"privacy:metadata";s:56:"The filter fontawesome does not store any personal data.";}