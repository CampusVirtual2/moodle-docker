a:91:{s:17:"automatictemplate";s:18:"Automatic template";s:22:"automatictemplate_desc";s:137:"If only one template is available to the user it will automatically be imported. The user will be notified on the page when this happens.";s:22:"automatictemplate_help";s:124:"The course template was automatically applied. If you require a different template, please contact the system administrator.";s:6:"buypro";s:17:"Buy Kickstart Pro";s:18:"buypromaxtemplates";s:199:"You are using the maximum number (<b>4</b>) of templates allowed in Kickstart free edition. To create more templates, purchase <a target="_blank" href="http://bdecent.de/kickstart">Kickstart Pro</a>.";s:13:"buyprosummary";s:56:"To unlock all Kickstart features purchase Kickstart Pro.";s:15:"confirmtemplate";s:56:"Are you sure you want to use this Template "{$a->name}"?";s:18:"strconfirmtemplate";s:42:"Are you sure you want to use this Template";s:13:"course_backup";s:25:"Course backup file (.mbz)";s:18:"course_backup_help";s:113:"When a user selects this template from within a course, this .mbz course backup will be imported into the course.";s:16:"course_templates";s:16:"Course templates";s:18:"coursebackupnotset";s:34:"Template has no course backup set.";s:21:"coursecreatorredirect";s:23:"Course creator redirect";s:26:"coursecreatorredirect_desc";s:193:"Force course creators to use Kickstart's "create from template" page when creating new courses. For example, when a course creator clicks "Add new course", they will be redirected to Kickstart.";s:15:"create_template";s:15:"Create template";s:24:"createcoursefromtemplate";s:27:"Create course from template";s:26:"defaultteacherinstructions";s:28:"Default teacher instructions";s:34:"defaultteacherinstructions_default";s:209:"<p>Currently, there's nothing in here, so start adding your content. We've made creating courses really easy for you. First, you choose a template that suits your course, then you can start adding content.</p>";s:31:"defaultteacherinstructions_desc";s:72:"Default content displayed to teachers before a template has been chosen.";s:23:"defaultuserinstructions";s:28:"Default student instructions";s:31:"defaultuserinstructions_default";s:124:"<p>Your teacher has not added any content into this course (yet).</p><p>If you have any questions, contact your teacher.</p>";s:28:"defaultuserinstructions_desc";s:87:"Default content displayed to students before a template has been chosen by the teacher.";s:6:"delete";s:6:"Delete";s:15:"delete_template";s:15:"Delete template";s:11:"description";s:11:"Description";s:4:"edit";s:4:"Edit";s:13:"edit_template";s:13:"Edit template";s:14:"enrollmenthelp";s:137:"Before continuing you may enroll teachers (or any users). Click <b>Course</b> in the secondary navigation to choose a template to import.";s:16:"general_settings";s:16:"General settings";s:6:"getpro";s:37:"Get more templates with Kickstart Pro";s:13:"goprotoenable";s:16:"Go Pro to enable";s:10:"gotocourse";s:12:"Go to course";s:12:"importcourse";s:13:"Import course";s:17:"importexplanation";s:158:"Here is a list of courses you are enrolled in as a teacher. You can import contents from these courses. Use the search box to narrow down the list of courses.";s:12:"importtarget";s:13:"Import target";s:17:"importtarget_desc";s:63:"Choose how Kickstart templates should be imported into courses.";s:20:"includesubcategories";s:21:"Include subcategories";s:25:"includesubcategories_help";s:86:"If checked, subcategories of chosen categories will also have access to this template.";s:30:"kickstart:import_from_template";s:21:"Import from templates";s:26:"kickstart:manage_templates";s:16:"Manage templates";s:9:"learnmore";s:10:"Learn more";s:16:"manage_templates";s:16:"Manage templates";s:18:"migratefromcourses";s:34:"Migrate content from other courses";s:11:"notemplates";s:31:"No templates are available yet.";s:10:"pluginname";s:16:"Kickstart format";s:10:"previewurl";s:11:"Preview URL";s:15:"previewurl_help";s:86:"If provided 