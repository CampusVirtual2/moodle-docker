a:13:{s:9:"ajaxerror";s:48:"Error contacting server to obtain quiz questions";s:11:"description";s:123:"This plugin allows you to limit access to another Moodle activity based just on the outcome of a single question in a quiz.";s:16:"error_selectquiz";s:23:"You must select a quiz.";s:20:"error_selectquestion";s:27:"You must select a question.";s:17:"error_selectstate";s:24:"You must select a state.";s:11:"label_state";s:14:"Required state";s:14:"label_question";s:35:"Which question in the selected quiz";s:10:"pluginname";s:35:"Restriction by single quiz question";s:16:"privacy:metadata";s:80:"The Restriction by single quiz question plugin does not store any personal data.";s:21:"questionnumberandname";s:25:"Q{$a->number}) {$a->name}";s:5:"title";s:13:"Quiz question";s:21:"requires_quizquestion";s:121:"The question <b>{$a->questiontext}</b> in <b><a href="{$a->quizurl}">{$a->quizname}</a></b> is <b>{$a->requiredstate}</b>";s:24:"requires_quizquestionnot";s:125:"The question <b>{$a->questiontext}</b> in <b><a href="{$a->quizurl}">{$a->quizname}</a></b> is not <b>{$a->requiredstate}</b>";}